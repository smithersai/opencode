  "version": "2.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "vibelang-source": "./src/index.ts",
      "default": "./.vibelang/js/src/index.js"
    },
    "./config": "./src/config.vibe",
    "./database": "./src/database.vibe",
    "./database/*": "./src/database/*.ts",
