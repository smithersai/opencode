module platform {
  export { EOL } from "node:os"

  export const createHeaders = (init?: HeadersInit) => new Headers(init)

  export const send = (path: string, base: string, init: RequestInit) => fetch(new URL(path, base), init)

  export const writeOutput = (text: string) => process.stdout.write(text)

  export const writeError = (text: string) => process.stderr.write(text)

  export const setExitCode = (code: typeof process.exitCode) => (process.exitCode = code)

  export const methods = new Set(["delete", "get", "head", "options", "patch", "post", "put"])

  type Operation = {
    operationId?: string
  }

  type OpenApi = {
    paths?: Record<string, Record<string, Operation>>
  }

  export function resolveOperation(spec: OpenApi, operationID: string, params: Record<string, string>) {
    for (const [path, operations] of Object.entries(spec.paths ?? {})) {
      for (const [method, operation] of Object.entries(operations)) {
        if (!methods.has(method) || operation.operationId !== operationID) continue
        return { method: method.toUpperCase(), path: interpolate(path, params) }
      }
    }
    throw new Error(`Operation not found: ${operationID}`)
  }

  export async function fetchOperation(
    url: string,
    headers: HeadersInit | undefined,
    operationID: string,
    params: Record<string, string>,
  ) {
    const response = await fetch(new URL("/openapi.json", url), { headers })
    if (!response.ok) throw new Error(`Failed to load OpenAPI document: HTTP ${response.status}`)
    return resolveOperation((await response.json()) as OpenApi, operationID, params)
  }

  /** @throws {Error} */
  function interpolate(path: string, params: Record<string, string>) {
    const used = new Set<string>()
    const pathname = path.replaceAll(/\{([^}]+)\}/g, (_, name: string) => {
      const value = params[name]
      if (value === undefined) throw new Error(`Missing path parameter: ${name}`)
      used.add(name)
      return encodeURIComponent(value)
    })
    const query = new URLSearchParams(Object.entries(params).filter(([name]) => !used.has(name))).toString()
    return query ? `${pathname}?${query}` : pathname
  }
}

import { EOL, createHeaders, fetchOperation, methods, send, setExitCode, writeError, writeOutput } from platform
import { Effect, Option } from "effect"
import { Commands } from "../commands.ts"
import { Runtime } from "../../framework/runtime.ts"
import { Service, type Endpoint } from "@opencode/client/effect/service"
import { ServerConnection } from "../../services/server-connection.ts"

export default Runtime.handler(
  Commands.commands.api,
  Effect.fn("cli.api")(function* (input) {
    const server = yield* ServerConnection.resolve({
      mismatch: "ignore",
    })
    const endpoint = server.endpoint
    const params = Option.getOrElse(input.param, () => ({}))
    const request = yield* resolveRequest(endpoint, input.request, params)
    const headers = createHeaders(Service.headers(endpoint))
    for (const header of input.header) {
      const index = header.indexOf(":")
      if (index < 1) return yield* Effect.fail(new Error(`Invalid header, expected name:value: ${header}`))
      yield* Effect.orDie(
        Effect.try({ try: () => headers.set(header.slice(0, index).trim(), header.slice(index + 1).trim()), catch: (e) => e }),
      )
    }
    const body = Option.getOrUndefined(input.data)
    if (body !== undefined && !headers.has("content-type"))
      yield* Effect.orDie(Effect.try({ try: () => headers.set("content-type", "application/json"), catch: (e) => e }))

    const response = yield* Effect.tryPromise(() =>
      send(request.path, endpoint.url, {
        method: request.method,
        headers,
        body,
      }),
    )
    const output = yield* Effect.promise(() => response.text())
    if (output) writeOutput(output + (output.endsWith(EOL) ? "" : EOL))
    if (!response.ok) {
      writeError(`HTTP ${response.status} ${response.statusText}${EOL}`)
      setExitCode(1)
    }
  }),
)

export { resolveOperation } from platform

export function rawRequest(input: readonly string[]) {
  if (input.length !== 2 || !methods.has(input[0].toLowerCase()) || !input[1].startsWith("/")) return
  return { method: input[0].toUpperCase(), path: input[1] }
}

function resolveRequest(endpoint: Endpoint, input: readonly string[], params: Record<string, string>) {
  const raw = rawRequest(input)
  if (raw) return Effect.succeed(raw)
  if (input.length !== 1) return Effect.fail(new Error("Expected an operation name or an HTTP method and path"))
  return Effect.tryPromise(() => fetchOperation(endpoint.url, Service.headers(endpoint), input[0], params))
}
