{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/simulation",
  "version": "2.2.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/simulation"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./backend": {
      "types": "./src/backend/index.d.vibe.ts",
      "vibelang-source": "./src/backend/index.vibe",
      "default": "./.vibelang/js/src/backend/index.js"
    },
    "./backend/*": "./src/backend/*.ts",
    "./frontend": "./src/frontend/simulation.ts",
    "./frontend/*": "./src/frontend/*.ts",
    "./protocol": "./src/protocol/index.ts",
    "./recording": "./src/recording.ts",
    "./backend/openai": {
      "types": "./src/backend/openai.d.vibe.ts",
      "vibelang-source": "./src/backend/openai.vibe",
      "default": "./.vibelang/js/src/backend/openai.js"
    },
    "./backend/simulated-provider": {
      "types": "./src/backend/simulated-provider.d.vibe.ts",
      "vibelang-source": "./src/backend/simulated-provider.vibe",
      "default": "./.vibelang/js/src/backend/simulated-provider.js"
    },
    "./frontend/renderer": {
      "types": "./src/frontend/renderer.d.vibe.ts",
      "vibelang-source": "./src/frontend/renderer.vibe",
      "default": "./.vibelang/js/src/frontend/renderer.js"
    },
    "./backend/openai.platform": null,
    "./backend/simulated-provider.platform": null,
    "./frontend/renderer.platform": null
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "test": "bun test --timeout 30000 --only-failures",
    "typecheck": "bun check --no-script -b",
    "typecheck:tsc": "vibelang -b"
  },
  "dependencies": {
    "@opencode/core": "workspace:*",
    "@opencode/ai": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@opencode/protocol": "workspace:*",
    "@opencode/util": "workspace:*",
    "@opentui/core": "catalog:",
    "effect": "catalog:",
    "ws": "8.21.0",
    "vibelang-runtime": "file:../../.vibelang-toolchain/0.0.14-pre.b9285da0f2be/tarballs/vibelang-runtime-0.0.14-pre.b9285da0f2be.tgz"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/ws": "8.18.1",
    "@typescript/native": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/0.0.14-pre.b9285da0f2be/tarballs/vibelang-0.0.14-pre.b9285da0f2be.tgz",
    "fast-check": "catalog:"
  }
}
