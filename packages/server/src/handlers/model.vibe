import { Model } from "@opencode/core/model"
import { Effect } from "effect"
import { HttpApiBuilder } from "effect/http-api"
import { Api } from "../api"
import { awaitPlugins, response } from "../location"

export const ModelHandler = HttpApiBuilder.group(Api, "server.model", (handlers) =>
  effect {
    return handlers
      .handle(
        "model.list",
        Effect.fn(effect function(ctx) {
          try awaitPlugins
          const models = try Model.Service
          return try response(models.available(ctx.query.types))
        }),
      )
      .handle(
        "model.default",
        Effect.fn(effect function() {
          try awaitPlugins
          const models = try Model.Service
          return try response(models.default())
        }),
      )
  })
