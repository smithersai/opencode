module platform {
  import { Effect } from "effect"
  export { EOL } from "node:os"

  export const write = (value: string) =>
    Effect.sync(() => {
      process.stdout.write(value)
    })
}

import { EOL, write } from platform
import { Effect, Option } from "effect"
import { Global } from "@opencode/util/global"
import { Commands } from "../../commands.ts"
import { Runtime } from "../../../framework/runtime"
import { databasePath } from "../../../database-path"

export default Runtime.handler(
  Commands.commands.debug.commands.paths,
  Effect.fn("cli.debug.paths")(effect function(input) {
    const global = try Global.Service
    const paths = { ...global, db: try Effect.try(() => databasePath(global.data)) }
    if (Option.isSome(input.name)) {
      try write(paths[input.name.value] + EOL)
      return
    }
    try write(
      Object.entries(paths)
        .map(([key, value]) => `${key.padEnd(10)} ${value}${EOL}`)
        .join(""),
    )
  }),
)
