module platform {
  // The platform code of export.vibe: the working directory, standard streams, the line ending and the exit code (EK4402).
  export { EOL } from "node:os"

  export function currentDirectory() {
    return process.cwd()
  }

  /** @throws {never} */
  export function stdinIsTTY() {
    return process.stdin.isTTY
  }

  /** @throws {never} */
  export function standardError() {
    return process.stderr
  }

  export function writeOutput(text: string) {
    return process.stdout.write(text)
  }

  export function writeError(text: string) {
    return process.stderr.write(text)
  }

  /** @throws {never} */
  export function setExitCode(code: number) {
    process.exitCode = code
  }
}

import { autocomplete, cancel, intro, isCancel, log, outro } from "@clack/prompts"
import { OpenCode } from "@opencode/client"
import { Service } from "@opencode/client/effect/service"
import { Effect, Option } from "effect"
import { Commands } from "../../commands.ts"
import { Runtime } from "../../../framework/runtime.ts"
import { ServerConnection } from "../../../services/server-connection.ts"
import { errorMessage } from "../../../util/error"
import { currentDirectory, EOL, setExitCode, standardError, stdinIsTTY, writeError, writeOutput } from platform

export default Runtime.handler(
  Commands.commands.session.commands.export,
  Effect.fn("cli.session.export")((input) =>
    Effect.gen(function* () {
      const requested = Option.getOrUndefined(input.session)
      if (!requested && !stdinIsTTY()) {
        yield* Effect.fail(new Error("Pass a session ID when running without an interactive terminal"))
      }
      const server = yield* ServerConnection.resolve()
      const client = OpenCode.make({
        baseUrl: server.endpoint.url,
        headers: Service.headers(server.endpoint),
      })
      const sessionID = requested
        ? requested
        : yield* Effect.gen(function* () {
            intro("Export session", { output: standardError() })
            const location = yield* Effect.tryPromise({
              try: () => client.location.get({ location: { directory: currentDirectory() } }),
              catch: (cause) => cause,
            })
            const page = yield* Effect.tryPromise({
              try: () =>
                client.session.list({
                  directory: location.directory,
                  parentID: null,
                  order: "desc",
                  limit: 50,
                }),
              catch: (cause) => cause,
            })
            if (page.data.length === 0) {
              log.error("No sessions found", { output: standardError() })
              outro("Done", { output: standardError() })
              return undefined
            }
            const selected = yield* Effect.tryPromise({
              try: () =>
                autocomplete({
                  message: "Select session to export",
                  maxItems: 10,
                  options: page.data.map((session) => ({
                    label: session.title,
                    value: session.id,
                    hint: `${new Date(session.time.updated).toLocaleString()} - ${session.id.slice(-8)}`,
                  })),
                  output: standardError(),
                }),
              catch: (cause) => cause,
            })
            if (isCancel(selected)) {
              cancel("Cancelled", { output: standardError() })
              setExitCode(130)
              return undefined
            }
            outro("Exporting session...", { output: standardError() })
            return selected
          })
      if (!sessionID) return
      const data = yield* Effect.tryPromise({
        try: () => client.session.export({ sessionID, sanitize: input.sanitize }),
        catch: (cause) => cause,
      })
      yield* Effect.try({ try: () => writeOutput(JSON.stringify(data, null, 2) + EOL), catch: (cause) => cause }).pipe(
        Effect.orDie,
      )
    }).pipe(
      Effect.catch((error) =>
        Effect.sync(() => {
          writeError(errorMessage(error) + EOL)
          setExitCode(1)
        }),
      ),
    ),
  ),
)
