{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.2.0",
  "name": "@opencode/sdk",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect/index.ts",
    "./workerd": "./src/workerd.ts",
    "./workerd/effect": "./src/effect/workerd.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "test": "bun test --timeout 5000",
    "typecheck": "bun check --no-script -b",
    "typecheck:tsc": "vibelang -b",
    "verify:package": "bun run script/verify-package.ts"
  },
  "dependencies": {
    "@opencode/client": "workspace:*",
    "@opencode/core": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/server": "workspace:*",
    "@opencode/util": "workspace:*",
    "effect": "catalog:",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-956814eb1e95.tgz"
  },
  "devDependencies": {
    "@opencode/ai": "workspace:*",
    "@opencode/httpapi-codegen": "workspace:*",
    "@opencode/protocol": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-b9d250df199d.tgz",
    "vibelang-unplugin": "file:../../.vibelang-toolchain/vibelang-unplugin-0.0.11-d83e2657e595.tgz"
  }
}
