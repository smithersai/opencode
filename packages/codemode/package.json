{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/codemode",
  "version": "2.2.0",
  "description": "Effect-native confined code execution over schema-described tools",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/codemode"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    ".vibelang/js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "vibelang-source": "./src/index.ts",
      "default": "./.vibelang/js/src/index.js"
    }
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "vibelang --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "effect": "catalog:",
    "vibelang-runtime": "file:../../.vibelang-toolchain/0.0.14-pre.b9285da0f2be/tarballs/vibelang-runtime-0.0.14-pre.b9285da0f2be.tgz"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/0.0.14-pre.b9285da0f2be/tarballs/vibelang-0.0.14-pre.b9285da0f2be.tgz",
    "typescript": "catalog:"
  }
}
