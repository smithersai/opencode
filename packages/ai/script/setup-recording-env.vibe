const hasFlag = (name: string) => args.includes(name)
const option = (name: string) => {
  const index = args.indexOf(name)
  if (index === -1) return undefined
  return args[index + 1]
}

const checkOnly = hasFlag("--check")
const providerOption = option("--providers")

const envNames = Array.from(new Set(PROVIDERS.flatMap((provider) => provider.vars.map((item) => item.name))))

const providersForOption = (value: string | undefined) => {
  if (!value || value === "recommended") {
    return PROVIDERS.filter((provider) => provider.tier === "core" || provider.tier === "canary")
  }
  if (value === "recorded") return PROVIDERS.filter((provider) => provider.tier !== "optional")
  if (value === "all") return PROVIDERS
  const ids = new Set(
    value
      .split(",")
      .map((item) => item.trim())
      .filter(Boolean),
  )
  return PROVIDERS.filter((provider) => ids.has(provider.id))
}

const chooseProviders = async () => {
  if (providerOption) return providersForOption(providerOption)
  return providersForOption("recommended")
}

const catchMissingFile = (error: PlatformError.PlatformError) => {
  if (error.reason._tag === "NotFound") return succeed("")
  return fail(error)
}

const readEnvFile = fn("RecordingEnv.readFile")(effect () => {
  const fileSystem = try FileSystem.FileSystem
  return try fileSystem.readFileString(envPath).pipe(Effect.catch(catchMissingFile))
})

const readConfigString = (provider: ConfigProvider.ConfigProvider, name: string) =>
  Config.String(name)
    .parse(provider)
    .pipe(
      Effect.match({
        onFailure: () => undefined,
        onSuccess: (value) => value,
      }),
    )

const parseEnv = fn("RecordingEnv.parseEnv")(effect (contents: string) => {
  const provider = ConfigProvider.fromDotEnvContents(contents)
  return Object.fromEntries(
    (try forEach(envNames, (name) => readConfigString(provider, name).pipe(map((value) => [name, value] as const))))
      .filter((entry): entry is readonly [string, string] => entry[1] !== undefined),
  )
})

const quote = (value: string) => JSON.stringify(value)

const status = (name: string, fileEnv: Env) => {
  if (fileEnv[name]) return "file"
  if (environmentValue(name)) return "shell"
  return "missing"
}

const statusLine = (provider: Provider, fileEnv: Env) =>
  [
    `${provider.label} (${provider.tier})`,
    provider.note,
    ...provider.vars.map((item) => {
      const value = status(item.name, fileEnv)
      const suffix = item.optional ? " optional" : ""
      return `  ${value === "missing" ? "missing" : "set"} ${item.name}${suffix}${
        value === "shell" ? " (shell only)" : ""
      }`
    }),
  ].join("\n")

const printStatus = (providers: ReadonlyArray<Provider>, fileEnv: Env) => {
  return recordingUI.note(
    providers.map((provider) => statusLine(provider, fileEnv)).join("\n\n"),
    `Recording env: ${envPath}`,
  )
}

const upsertEnv = (contents: string, values: Env) => {
  const names = Object.keys(values)
  const seen = new Set<string>()
  const lines = contents.split(/\r?\n/).map((line) => {
    const match = line.match(/^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)\s*=/)
    if (!match || !names.includes(match[1])) return line
    seen.add(match[1])
    return `${match[1]}=${quote(values[match[1]])}`
  })
  const missing = names.filter((name) => !seen.has(name))
  if (missing.length === 0) return lines.join("\n").replace(/\n*$/, "\n")
  const prefix = lines.join("\n").trimEnd()
  const block = [
    "",
    "# Added by bun run setup:recording-env",
    ...missing.map((name) => `${name}=${quote(values[name])}`),
  ].join("\n")
  return `${prefix}${block}\n`
}

const providerRequiredStatus = (provider: Provider, fileEnv: Env) => {
  const required = requiredVars(provider)
  if (required.some((item) => status(item.name, fileEnv) === "missing")) return "missing"
  if (required.some((item) => status(item.name, fileEnv) === "shell")) return "set in shell"
  return "already added"
}

const requiredVars = (provider: Provider) => provider.vars.filter((item) => !item.optional)

const promptVars = (provider: Provider) => provider.vars.filter((item) => !item.optional || item.secret === false)

const envValue = (env: Env, names: ReadonlyArray<string>) => names.map((name) => env[name]).find(Boolean) ?? ""

const envWithValues = (fileEnv: Env, values: Env): Env => ({
  ...environment(),
  ...fileEnv,
  ...values,
})

const responseError = fn("RecordingEnv.responseError")(effect (
  response: HttpClientResponse.HttpClientResponse,
) => {
  if (response.status >= 200 && response.status < 300) return undefined
  const body = try response.text.pipe(orElseSucceed(() => ""))
  return `${response.status}${body ? `: ${body.slice(0, 180)}` : ""}`
})

const executeRequest = fn("RecordingEnv.executeRequest")(effect (
  request: HttpClientRequest.HttpClientRequest,
) => {
  const http = try HttpClient.HttpClient
  return try http.execute(request).pipe(Effect.flatMap(responseError))
})

const validateBearer = (url: string, token: Redacted.Redacted<string>, headers: Record<string, string> = {}) =>
  HttpClientRequest.get(url).pipe(
    HttpClientRequest.setHeaders({ ...headers, authorization: `Bearer ${Redacted.value(token)}` }),
    executeRequest,
  )

const validateChat = (input: {
  readonly url: string
  readonly token: Redacted.Redacted<string>
  readonly tokenHeader?: string
  readonly model: string
  readonly headers?: Record<string, string>
}) => effect {
  const request = try Effect.try({
    try: () => ProviderShared.jsonPost({
      url: input.url,
      headers: { ...input.headers, [input.tokenHeader ?? "authorization"]: `Bearer ${Redacted.value(input.token)}` },
      body: ProviderShared.encodeJson({
        model: input.model,
        messages: [{ role: "user", content: "Reply with exactly: ok" }],
        max_tokens: 3,
        temperature: 0,
      }),
    }),
    catch: (cause) => cause,
  }).pipe(orDie)
  return try executeRequest(request)
}

const validateBedrock = (env: Env) =>
  effect {
    const request = try promise(() =>
      new AwsV4Signer({
        url: `https://bedrock.${env.BEDROCK_RECORDING_REGION || "us-east-1"}.amazonaws.com/foundation-models`,
        method: "GET",
        service: "bedrock",
        region: env.BEDROCK_RECORDING_REGION || "us-east-1",
        accessKeyId: env.AWS_ACCESS_KEY_ID,
        secretAccessKey: env.AWS_SECRET_ACCESS_KEY,
        sessionToken: env.AWS_SESSION_TOKEN || undefined,
      }).sign()
    )
    return try HttpClientRequest.get(request.url.toString()).pipe(
      HttpClientRequest.setHeaders(Object.fromEntries(request.headers.entries())),
      executeRequest,
    )
  }

const validateProvider = fn("RecordingEnv.validateProvider")(effect (provider: Provider, env: Env) => {
  return try (provider.validate?.(env) ?? succeed("no lightweight validator")).pipe(
    Effect.catch((error) => {
      if (error instanceof Error) return succeed(error.message)
      return succeed(String(error))
    }),
  )
})

const validateProviders = fn("RecordingEnv.validateProviders")(effect (
  providers: ReadonlyArray<Provider>,
  env: Env,
) => {
  const progress = try recordingUI.spinner()
  try progress.start("Validating credentials")
  const results = try forEach(
    providers,
    (provider) => validateProvider(provider, env).pipe(map((error) => ({ provider, error }))),
    { concurrency: 4 },
  )
  try progress.stop("Validation complete")
  try recordingUI.note(
    results
      .map(
        (result) =>
          `${result.error ? "failed" : "ok"} ${result.provider.label}${result.error ? ` - ${result.error}` : ""}`,
      )
      .join("\n"),
    "Credential validation",
  )
})

const writeEnvFile = fn("RecordingEnv.writeFile")(effect (contents: string) => {
  const fileSystem = try FileSystem.FileSystem
  try fileSystem.makeDirectory(envDirectory(envPath), { recursive: true })
  try fileSystem.writeFileString(envPath, contents, { mode: 0o600 })
})

const prompt = <A>(run: () => Promise<A | symbol>) => promise(run).pipe(flatMap(handleCancellation))

const chooseConfigurableProviders = fn("RecordingEnv.chooseConfigurableProviders")(effect (
  providers: ReadonlyArray<Provider>,
  fileEnv: Env,
) => {
  const configurable = providers.filter((provider) => requiredVars(provider).length > 0)
  const selected = try prompt<ReadonlyArray<string>>(() =>
    multiselect({
      message: "Select provider credentials to add or override",
      options: configurable.map((provider) => ({
        value: provider.id,
        label: provider.label,
        hint: `${providerRequiredStatus(provider, fileEnv)} - ${
          requiredVars(provider)
            .map((item) => item.name)
            .join(", ")
        }`,
      })),
      initialValues: configurable
        .filter((provider) => providerRequiredStatus(provider, fileEnv) === "missing")
        .map((provider) => provider.id),
    })
  )
  return configurable.filter((provider) => selected.includes(provider.id))
})

const promptEnvVar = (item: Provider["vars"][number]) =>
  prompt<string>(() => {
    const input = {
      message: item.label ?? item.name,
      validate: (input: string | undefined) => {
        if (item.optional) return undefined
        return !input || input.length === 0 ? "Leave blank by pressing Esc/cancel, or paste a value" : undefined
      },
    }
    return item.secret === false ? text(input) : password(input)
  })

const promptProviderValues = fn("RecordingEnv.promptProviderValues")(effect (
  providers: ReadonlyArray<Provider>,
) => {
  const values: Env = {}
  for (const provider of providers) {
    try recordingUI.info(`${provider.label}: ${provider.note}`)
    for (const item of promptVars(provider)) {
      if (values[item.name]) continue
      const value = try promptEnvVar(item)
      if (value !== "") values[item.name] = value
    }
  }
  return values
})

const main = fn("RecordingEnv.main")(effect () => {
  try recordingUI.intro("LLM recording credentials")
  const contents = try readEnvFile()
  const fileEnv = try parseEnv(contents)
  const providers = try promise(() => chooseProviders())
  try printStatus(providers, fileEnv)
  if (checkOnly) {
    try recordingUI.outro("Check complete")
    return
  }
  if (!interactive) {
    try recordingUI.outro("Run this command in a terminal to enter credentials")
    return
  }

  const selectedProviders = try chooseConfigurableProviders(providers, fileEnv)
  const values = try promptProviderValues(selectedProviders)

  if (Object.keys(values).length === 0) {
    try recordingUI.outro("No changes")
    return
  }

  if (
    interactive
    && (try prompt(() => confirm({ message: "Validate credentials before saving?", initialValue: true })))
  ) {
    try validateProviders(selectedProviders, envWithValues(fileEnv, values))
  }

  try writeEnvFile(upsertEnv(contents, values))
  try recordingUI.success(
    `Saved ${Object.keys(values).length} value${Object.keys(values).length === 1 ? "" : "s"} to ${envPath}`,
  )
  try recordingUI.outro("Keep .env.local local. Store shared team credentials in a password manager or vault.")
})

await runPromise(main().pipe(Effect.provide(NodeFileSystem.layer), Effect.provide(FetchHttpClient.layer)))

module platform {
  import { cancel, intro, isCancel, log, note, outro, spinner } from "@clack/prompts"
  import { Effect } from "effect"
  import path from "node:path"

  export const args = process.argv.slice(2)
  export const interactive = Boolean(process.stdin.isTTY && process.stdout.isTTY)
  const envIndex = args.indexOf("--env")
  export const envPath = path.resolve(process.cwd(), (envIndex === -1 ? undefined : args[envIndex + 1]) ?? ".env.local")

  /** @throws {never} */
  export function envDirectory(file: string) {
    return path.dirname(file)
  }

  /** @throws {never} */
  export function environmentValue(name: string) {
    return process.env[name]
  }

  /** @throws {never} */
  export function environment(): Record<string, string> {
    return Object.fromEntries(
      Object.entries(process.env).filter((entry): entry is [string, string] => entry[1] !== undefined),
    )
  }

  export function handleCancellation<A>(value: A | symbol): Effect.Effect<A> {
    return Effect.sync(() => {
      // SAFETY: The prompt's cancellation symbol exits; every other value retains its generic result type.
      if (!isCancel(value)) return value as A
      cancel("Cancelled")
      process.exit(130)
    })
  }

  export const recordingUI = {
    intro: (message: string) => Effect.sync(() => intro(message)),
    outro: (message: string) => Effect.sync(() => outro(message)),
    note: (message: string, title: string) => Effect.sync(() => note(message, title)),
    info: (message: string) => Effect.sync(() => log.info(message)),
    success: (message: string) => Effect.sync(() => log.success(message)),
    spinner: () => Effect.sync(() => {
      const progress = spinner()
      return {
        start: (message: string) => Effect.sync(() => progress.start(message)),
        stop: (message: string) => Effect.sync(() => progress.stop(message)),
      }
    }),
  }
}
