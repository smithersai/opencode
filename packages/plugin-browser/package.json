{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-browser",
  "version": "2.2.0",
  "description": "OpenCode's desktop browser plugin",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugin-browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    ".vibelang/js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.vibe.ts",
      "vibelang-source": "./src/index.vibe",
      "default": "./.vibelang/js/src/index.js"
    },
    "./rpc": {
      "types": "./src/rpc.d.vibe.ts",
      "vibelang-source": "./src/rpc.vibe",
      "default": "./.vibelang/js/src/rpc.js"
    },
    "./proxy": {
      "types": "./src/proxy.ts",
      "vibelang-source": "./src/proxy.ts",
      "default": "./.vibelang/js/src/proxy.js"
    }
  },
  "scripts": {
    "build": "vibelang -p tsconfig.build.json",
    "pack": "bun run script/pack.ts",
    "typecheck": "bun check --no-script -p tsconfig.test.json",
    "typecheck:tsc": "vibelang --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "effect": "catalog:",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.13-89b143f8885a.tgz"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.13-637d08c93ff1.tgz",
    "fast-check": "catalog:"
  }
}
