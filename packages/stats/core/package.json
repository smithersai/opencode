      "default": "./.vibelang/js/src/domain/home.js"
    },
    "./domain/catalog-identity": {
      "types": {
        "default": "./src/domain/catalog-identity.ts"
      },
      "vibelang-source": "./src/domain/catalog-identity.ts",
      "default": "./.vibelang/js/src/domain/catalog-identity.js"
