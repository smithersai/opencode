import { OpenApi } from "effect/http-api"
import { format } from "prettier"
import { checkRequested, finishCheck, readOpenApi, writeOpenApi } from "./generate-openapi.platform.ts"
import { ClientApi } from "../src/client.js"
import { stabilizeOpenApi } from "./openapi-stabilize.js"

const document = await format(JSON.stringify(stabilizeOpenApi(OpenApi.fromApi(ClientApi)), null, 2), {
  parser: "json",
  printWidth: 120,
})

if (checkRequested()) finishCheck((await readOpenApi()) !== document)

await writeOpenApi(document)
