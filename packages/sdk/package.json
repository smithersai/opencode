{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.2.0",
  "name": "@opencode/sdk",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    ".vibelang/js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "vibelang-source": "./src/index.ts",
      "default": "./.vibelang/js/src/index.js"
    },
    "./effect": {
      "types": "./src/effect/index.ts",
      "vibelang-source": "./src/effect/index.ts",
      "default": "./.vibelang/js/src/effect/index.js"
    },
    "./workerd": {
      "types": "./src/workerd.ts",
      "vibelang-source": "./src/workerd.ts",
      "default": "./.vibelang/js/src/workerd.js"
    },
    "./workerd/effect": {
      "types": "./src/effect/workerd.ts",
      "vibelang-source": "./src/effect/workerd.ts",
      "default": "./.vibelang/js/src/effect/workerd.js"
    }
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "test": "bun test --timeout 5000",
    "typecheck": "bun check --no-script -b",
    "typecheck:tsc": "vibelang -b",
    "verify:package": "bun run script/verify-package.ts"
  },
  "dependencies": {
    "@opencode/client": "workspace:*",
    "@opencode/core": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/server": "workspace:*",
    "@opencode/util": "workspace:*",
    "effect": "catalog:",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.13-89b143f8885a.tgz"
  },
  "devDependencies": {
    "@opencode/ai": "workspace:*",
    "@opencode/httpapi-codegen": "workspace:*",
    "@opencode/protocol": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.13-637d08c93ff1.tgz",
    "vibelang-unplugin": "file:../../.vibelang-toolchain/vibelang-unplugin-0.0.13-23b4ad6a3929.tgz",
    "fast-check": "catalog:",
    "typescript": "catalog:"
  }
}
