export * as EventFeed from "./event-feed.vibe"

import { Bus } from "@opencode/core/bus"
import { Event } from "@opencode/schema/event"
import { isOpenCodeEvent, type OpenCodeEvent } from "@opencode/protocol/groups/event"
import { Cause, Effect, Layer, Schema, Scope, Stream } from "effect"

export const SubscriberCapacity = 4_096

export class SubscriberOverflowError extends Schema.TaggedError<SubscriberOverflowError>()(
  "EventFeed.SubscriberOverflow",
  { capacity: Schema.Int },
) {}

export class EncodingError extends Schema.TaggedError<EncodingError>()("EventFeed.EncodingError", {
  eventID: Event.ID,
  eventType: Schema.String,
  cause: Schema.Defect(),
}) {}

export type Error = SubscriberOverflowError | EncodingError

export interface Interface {
  readonly subscribe: (types?: ReadonlyArray<string>) => Stream.Stream<string, Error>!never!Scope.Scope
}

export service Service: Interface {
  static readonly key = "@opencode/server/EventFeed"
}

export function frame(event: OpenCodeEvent) {
  return `data: ${JSON.stringify(event)}\n\n`
}

export const make = effect (
  observe: (subscriber: Bus.Subscriber) => Bus.Unsubscribe!!,
  options?: { readonly capacity?: number; readonly encode?: (event: OpenCodeEvent) => string } | undefined,
) =>
  try withSpan(
    effect {
      const capacity = options?.capacity ?? SubscriberCapacity
      const render = options?.encode ?? frame
      const subscribers = new Map<Queue.Queue<string, Error>, ReadonlySet<string> | undefined>()

      const fail = effect (error: Error) =>
        {
          const current = Array.from(subscribers.keys())
          subscribers.clear()
          for (const subscriber of current) Queue.failCauseUnsafe(subscriber, Cause.fail(error))
        }

      const publish = effect (event: Event.Payload) => {
        if (!isOpenCodeEvent(event)) return
        let encoded: string | undefined
        for (const [subscriber, types] of subscribers) {
          if (types && !types.has(event.type)) continue
          encoded ??= Effect.try({
            try: () => render(event),
            catch: (cause) => new EncodingError({ eventID: event.id, eventType: event.type, cause }),
          }) catch effect (error) =>
            try (Effect.logError("Failed to encode public event", {
              eventID: error.eventID,
              eventType: error.eventType,
              cause: error.cause,
            }) |> Effect.andThen(%, fail(error)) |> Effect.as(%, undefined))
          if (encoded === undefined) return
          if (Queue.offerUnsafe(subscriber, encoded)) continue
          subscribers.delete(subscriber)
          Queue.failCauseUnsafe(subscriber, Cause.fail(new SubscriberOverflowError({ capacity })))
        }
      }

      const unsubscribe = try observe(publish)
      try Effect.addFinalizer(() => unsubscribe)

      return Service.of({
        subscribe: (types) =>
          Effect.acquireRelease(
            Queue.dropping<string, Error>(capacity)
              |> Effect.tap(%, effect (queue) => subscribers.set(queue, types?.length ? new Set(types) : undefined)),
            (queue) =>
              effect {
                return subscribers.delete(queue)
              } |> Effect.andThen(%, Queue.shutdown(queue)) |> Effect.asVoid(%),
          ) |> Effect.map(%, Stream.fromQueue),
      })
    },
    "EventFeed.make",
  )

export const layer = Layer.effect(
  Service,
  effect {
    const bus = try Bus.Service
    return try make(bus.listen)
  },
)
