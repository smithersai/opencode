{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/protocol",
  "version": "2.2.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/protocol"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./simulation": {
      "types": "./src/simulation.d.vibe.ts",
      "vibelang-source": "./src/simulation.vibe",
      "default": "./.vibelang/js/src/simulation.js"
    },
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "generate": "bun run script/generate-openapi.ts",
    "check:generated": "bun run script/generate-openapi.ts --check",
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "vibelang --noEmit"
  },
  "dependencies": {
    "@opencode/schema": "workspace:*",
    "effect": "catalog:",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-587937650a6b.tgz"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "prettier": "3.6.2",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-1ded989eae73.tgz"
  }
}
