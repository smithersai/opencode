import { environmentValue, preferEnvironment, configureProxy, configureCertificates } from "./environment.platform.ts"
import { currentPlatform } from "./environment.platform.ts"
import { app } from "electron"
import { DesktopPaths } from "../paths.vibe"
import { getUserShell, loadShellEnv } from "../service/shell-env.vibe"
import { registerRendererProtocol, setDockIcon, setProtocolReporter } from "../windows/index.vibe"
import { scoped } from "../native/logging"

// electron-context-menu attaches to every existing and future window, so it can load once the first
// window is up instead of holding up startup with its dependency tree.
export const installContextMenu = effect {
  const { default: contextMenu } = try Effect.promise(() => import("electron-context-menu"))
  try Effect.orDie(Effect.try({ try: () => contextMenu({ showSaveImageAs: true, showLookUpSelection: false, showSearchWithGoogle: false }), catch: (e) => e }))
}

export const prepareApplicationEnvironment = effect {
  try loadSystemCertificates
  try loadProxyEnvironment
}

export const preferApplicationEnvironment = effect {
  const shell = (try Effect.orDie(Effect.try({ try: () => currentPlatform(), catch: (e) => e }))) === "win32" ? null : getUserShell()
  const shellEnv = shell ? try loadShellEnv(shell) : null
  try Effect.sync(() => preferEnvironment(shellEnv))
}

export const prepareDesktop = effect {
  const path = try Path.Path
  const paths = try DesktopPaths.resolve

  if (app.isPackaged || (try Effect.orDie(Effect.try({ try: () => environmentValue("OPENCODE_DESKTOP_DISABLE_PROTOCOL_REGISTRATION"), catch: (e) => e }))) !== "1")
    try Effect.orDie(Effect.try({ try: () => app.setAsDefaultProtocolClient("opencode"), catch: (e) => e }))
  const runFork = Effect.runForkWith(try Effect.context())
  try Effect.orDie(Effect.try({ try: () => setProtocolReporter((level, message, data) =>
    runFork(scoped("protocol", level === "error" ? Effect.logError(message, data) : Effect.logWarning(message, data))),
  ), catch: (e) => e }))
  try Effect.orDie(Effect.try({ try: () => registerRendererProtocol(paths.rendererRoot), catch: (e) => e }))
  try Effect.orDie(Effect.try({ try: () => setDockIcon(path, paths), catch: (e) => e }))
}

export const loadProxyEnvironment = effect {
  Effect.try(() => {
    configureProxy()
  }) catch effect (error) => try Effect.logWarning("failed to load proxy environment", { error })
}

const loadSystemCertificates = Effect.try({
  try: configureCertificates,
  catch: (error) => error,
}) |> Effect.catch(%, (error) => Effect.logWarning("failed to load system certificates", { error }))
