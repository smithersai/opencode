import { outputColumns } from "./upgrade.platform"
import { intro, log, outro, spinner } from "@clack/prompts"
import { Effect, Option } from "effect"
import { Commands } from "../commands.ts"
import { Runtime } from "../../framework/runtime"
import { Updater } from "../../services/updater"
import { handlePromptErrors } from "../../ui/prompt"
import { OPENCODE_VERSION } from "../../version.ts"
import { stripVTControlCharacters } from "./upgrade.platform"

export default Runtime.handler(
  Commands.commands.upgrade,
  Effect.fn("cli.upgrade")(
    effect function(input) {
      void (try ((args: Parameters<typeof intro>) => Effect.try(() => intro(...args)).pipe(Effect.orDie))(["Upgrade"]))
      const updater = try Updater.Service
      const method = Option.getOrUndefined(input.method) ?? (try updater.method())
      if (!method) {
        return try Effect.fail(
          new Error("Could not detect the installation method. Pass --method to choose how to upgrade OpenCode."),
        )
      }

      void (try ((args: Parameters<typeof log.info>) => Effect.try(() => log.info(...args)).pipe(Effect.orDie))([
        `Using method: ${method}`,
      ]))
      const target = Option.getOrUndefined(input.target) ?? (try updater.latest(method))
      const version = target.trim().replace(/^v/, "")
      if (version === OPENCODE_VERSION) {
        void (try ((args: Parameters<typeof log.warn>) => Effect.try(() => log.warn(...args)).pipe(Effect.orDie))([
          `OpenCode upgrade skipped: ${version} is already installed`,
        ]))
        void (try ((args: Parameters<typeof outro>) => Effect.try(() => outro(...args)).pipe(Effect.orDie))(["Done"]))
        return
      }

      void (try ((args: Parameters<typeof log.info>) => Effect.try(() => log.info(...args)).pipe(Effect.orDie))([
        `From ${OPENCODE_VERSION} → ${version}`,
      ]))
      const progress =
        try ((args: Parameters<typeof spinner>) => Effect.try(() => spinner(...args)).pipe(Effect.orDie))([])
      void (try ((args: Parameters<typeof progress.start>) =>
        Effect.try(() => progress.start(...args)).pipe(Effect.orDie))(["Upgrading..."]))
      try updater.upgrade(method, target).pipe(
        Effect.tap(() => Effect.sync(() => progress.stop("Upgrade complete"))),
        Effect.tapCause(() => Effect.sync(() => progress.stop("Upgrade failed", 1))),
      )
      void (try ((args: Parameters<typeof outro>) => Effect.try(() => outro(...args)).pipe(Effect.orDie))(["Done"]))
    },
    (effect) =>
      handlePromptErrors(
        effect.pipe(
          Effect.mapError((error) =>
            error instanceof Updater.UpgradeError ? new Error(formatUpgradeError(error), { cause: error }) : error
          ),
        ),
      ),
  ),
)

function formatUpgradeError(error: Updater.UpgradeError) {
  const clean = (value: string) => stripVTControlCharacters(value).replaceAll("\r", "").trim()
  const line = (value: string) => clean(value).replace(/\s+/g, " ")
  const detail = wrap(clean(error.detail), Math.max(24, (outputColumns() ?? 80) - 7)).join("\n")
  return [
    line(error.title),
    "",
    detail,
    ...(error.command ? ["", field("Command", line(error.command))] : []),
    field("Retry", line(error.retry)),
  ].join("\n")
}

function field(label: string, value: string) {
  const prefix = label.padEnd(9)
  const width = Math.max(24, Math.min(61, (outputColumns() ?? 80) - prefix.length - 10))
  const lines = wrap(value, width)
  return lines.map((line, index) => `${index === 0 ? prefix : " ".repeat(prefix.length)}${line}`).join("\n")
}

function wrap(value: string, width: number) {
  return value.split("\n").flatMap((source) => {
    if (source.length <= width) return [source]
    return source.split(/\s+/).reduce<string[]>((result, word) => {
      const index = result.length - 1
      if (index < 0 || result[index].length + word.length + 1 > width) result.push(word)
      else result[index] += ` ${word}`
      return result
    }, [])
  })
}
