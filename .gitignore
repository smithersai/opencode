# Non-runtime output copied by workspace compilation
**/.vibelang/js/bin/
**/.vibelang/js/component-tests/
**/.vibelang/js/dev/
**/.vibelang/js/performance/
**/.vibelang/js/script/
**/.vibelang/js/*.config.js

# TypeScript projections generated by the VibeLang compiler.
**/*.d.vibe.ts
**/*.d.vibex.ts
**/*.vibe.platform.d.ts
**/*.vibex.platform.d.ts
# Each x.vibe also gets x.d.ts, which re-exports x.d.vibe.ts so native importers resolve ./x.js.
# Hand-written declarations are already tracked; new ones need git add -f.
**/*.d.ts

# Loader records depend on the locally installed native compiler.
**/.vibelang/js/.loader/
