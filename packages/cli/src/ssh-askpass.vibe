module platform {
  export const environmentValue = (key: string) => process.env[key]

  export const argumentVector = () => process.argv

  export const makeTextDecoder = () => new TextDecoder()

  export const decodeText = (decoder: TextDecoder, ...args: Parameters<TextDecoder["decode"]>) => decoder.decode(...args)
}

import { argumentVector, environmentValue } from platform
import { makeTextDecoder, decodeText } from platform
import { NodeSocket } from "@effect/platform-node"
import { Effect, Schema, Stdio, Stream } from "effect"
import { Socket } from "effect/socket"

const Response = Schema.fromJsonString(Schema.Struct({ value: Schema.NullOr(Schema.String) }))
const Port = Schema.NumberFromString.check(Schema.isInt(), Schema.isGreaterThan(0), Schema.isLessThanOrEqualTo(65535))

// OpenSSH invokes the executable directly, including on Windows. Run outside
// normal CLI observability so neither prompts nor responses enter its logs.
export const askpass = effect {
  const port = try Schema.decodeUnknownEffect(Port)(
    try ((args: Parameters<typeof environmentValue>) =>
      Effect.try(() => environmentValue(...args)).pipe(Effect.orDie))(["OPENCODE_SSH_ASKPASS_PORT"]),
  )
  const stdio = try Stdio.Stdio
  const socket = try NodeSocket.makeNet({ host: "127.0.0.1", port })
  const pull = try Socket.readerBytes(socket)
  const writer = try socket.writer
  void try writer.write(
    JSON.stringify({
      token: (try ((args: Parameters<typeof environmentValue>) =>
        Effect.try(() =>
          environmentValue(...args)
        ).pipe(Effect.orDie))(["OPENCODE_SSH_ASKPASS_TOKEN"])),
      text: (try ((args: Parameters<typeof argumentVector>) =>
        Effect.try(() => argumentVector(...args)).pipe(Effect.orDie))([])).slice(2).join(" "),
      confirm: (try ((args: Parameters<typeof environmentValue>) =>
        Effect.try(() =>
          environmentValue(...args)
        ).pipe(Effect.orDie))(["SSH_ASKPASS_PROMPT"])) === "confirm",
    }) + "\n",
  )
  // One streaming decoder, so a character split across reads decodes intact.
  const decoder = try ((args: Parameters<typeof makeTextDecoder>) =>
    Effect.try(() => makeTextDecoder(...args)).pipe(Effect.orDie))([])
  const response = { text: "" }
  try effect {
    while (true) {
      for (const chunk of try pull) {
        response.text += try ((args: Parameters<typeof decodeText>) =>
          Effect.try(() =>
            decodeText(...args)
          ).pipe(Effect.orDie))([decoder, chunk, { stream: true }])
      }
    }
  }.pipe(Effect.catchReason("SocketError", "SocketCloseError", () => Effect.void))
  const result = try Schema.decodeUnknownEffect(Response)(response.text)
  if (result.value === null) return 1
  try Stream.make(result.value + "\n").pipe(Stream.run(stdio.stdout({ endOnDone: false })))
  return 0
}.pipe(
  Effect.scoped,
  Effect.timeout("5 minutes"),
  Effect.orElseSucceed(() => 1),
)
