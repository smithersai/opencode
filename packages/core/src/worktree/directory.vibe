export * as WorktreeDirectory from "./directory.vibe"

import { Schema } from "effect"
import { FSUtil } from "@opencode/util/fs-util"
import { AbsolutePath } from "../schema.js"

export class DirectoryUnavailableError extends Schema.TaggedError<DirectoryUnavailableError>()(
  "Worktree.DirectoryUnavailableError",
  { directory: AbsolutePath },
) {}

export const canonical = effect (fs: FSUtil.Interface, input: AbsolutePath) => {
  const resolved = AbsolutePath.make(try fs.resolve(input))
  if (!(try fs.isDir(resolved))) throw new DirectoryUnavailableError({ directory: input })
  return resolved
}
