{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/theme",
  "version": "2.2.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/theme"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./tui": {
      "types": "./src/tui/index.ts",
      "vibelang-source": "./src/tui/index.ts",
      "default": "./.vibelang/js/src/tui/index.js"
    },
    "./tui/v1": {
      "types": "./src/tui/v1.ts",
      "vibelang-source": "./src/tui/v1.ts",
      "default": "./.vibelang/js/src/tui/v1.js"
    }
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "test": "bun test --timeout 30000",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "vibelang --noEmit"
  },
  "dependencies": {
    "@opentui/core": "catalog:",
    "effect": "catalog:",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-587937650a6b.tgz"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-1ded989eae73.tgz",
    "vibelang-vite": "file:../../.vibelang-toolchain/vibelang-vite-0.0.11-5223c46c8aba.tgz"
  }
}
