import { define } from "@opencode/plugin/effect/plugin"
import type { AISDKHooks } from "@opencode/plugin/effect/aisdk"

export function createProviderPlugin(input: {
  readonly id: string
  readonly package: string
  readonly load: (options: AISDKHooks["sdk"]["options"]) => Promise<unknown>
}) {
  return define({
    id: input.id,
    effect: effect (ctx) => {
      try ctx.aisdk.hook(
        "sdk",
        effect (evt) => {
          if (evt.package !== input.package) return
          evt.sdk = try Effect.promise(() => input.load(evt.options))
        },
      )
    },
  })
}
