export * as WorktreeEvent from "./worktree-event.vibe"

import { optional } from "./schema.vibe"
import { Event } from "./event.ts"

export const Ready = Event.ephemeral({
  type: "worktree.ready",
  schema: {
    name: Schema.String,
    branch: optional(Schema.String),
  },
})

export const Failed = Event.ephemeral({
  type: "worktree.failed",
  schema: {
    message: Schema.String,
  },
})

export const Definitions = Event.inventory(Ready, Failed)
