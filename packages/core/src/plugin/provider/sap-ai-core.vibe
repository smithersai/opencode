import { Effect } from "effect"
import { define } from "@opencode/plugin/effect/plugin"
import { Npm } from "@opencode/util/npm"
import { Provider } from "../../provider.js"
import { loadSDKFactory } from "./sdk-factory.js"
import { environmentValue, setEnvironmentValue } from platform

export const SapAICorePlugin = define({
  id: "opencode.provider.sap.ai.core",
  effect: Effect.fn(function* (ctx) {
    const npm = yield* Npm.Service
    yield* ctx.aisdk.hook(
      "sdk",
      Effect.fn(function* (evt) {
        if (evt.model.providerID !== Provider.ID.make("sap-ai-core")) return
        const serviceKey =
          environmentValue("AICORE_SERVICE_KEY") ??
          (typeof evt.options.serviceKey === "string" ? evt.options.serviceKey : undefined)
        if (serviceKey && !environmentValue("AICORE_SERVICE_KEY")) setEnvironmentValue("AICORE_SERVICE_KEY", serviceKey)

        const factory = yield* loadSDKFactory(npm, evt.package)
        if (typeof factory !== "function")
          return yield* Effect.die(new Error(`Package ${evt.package} provider factory export is not callable`))

        evt.sdk = factory(
          serviceKey
            ? {
                deploymentId: environmentValue("AICORE_DEPLOYMENT_ID"),
                resourceGroup: environmentValue("AICORE_RESOURCE_GROUP"),
              }
            : {},
        )
      }),
    )
    yield* ctx.aisdk.hook(
      "language",
      Effect.fn(function* (evt) {
        if (evt.model.providerID !== Provider.ID.make("sap-ai-core")) return
        evt.language = evt.sdk(evt.model.modelID ?? evt.model.id)
      }),
    )
  }),
})

module platform {
// The platform code of sap-ai-core.vibe: environment variable access, which a .vibe file does not do (EK4402).

/** @throws {never} */
export function environmentValue(key: string): string | undefined {
  return process.env[key]
}

/** @throws {never} */
export function setEnvironmentValue(key: string, value: string): void {
  process.env[key] = value
}
}
