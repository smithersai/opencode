export * as VcsHgPlugin from "./hg.js"

import { Effect } from "effect"
import { ChildProcess } from "effect/process"
import { define } from "@opencode/plugin/effect/plugin"
import { FileDiff } from "@opencode/schema/file-diff"
import { FileStatus, Info, Mode } from "@opencode/schema/vcs"
import { FSUtil } from "@opencode/util/fs-util"
import { AppProcess } from "@opencode/util/process"
import { Location } from "../../location.js"
import type { Adapter, DiffOptions } from "../../vcs.js"
import { DiffError } from "../../vcs.js"
import {
  addPatch,
  chunksByFile,
  countPatch,
  deletePatch,
  emptyPatch,
  MAX_PATCH_BYTES,
  MAX_TOTAL_PATCH_BYTES,
  PATCH_CONTEXT_LINES,
} from "../../vcs/patch.js"
import { byteLength, joinPath, relativePath } from "./hg.platform.ts"

export const Plugin = define({
  id: "opencode.vcs.hg",
  effect: Effect.fn("VcsHgPlugin")(effect (ctx) => {
    const location = try Location.Service
    // Markerless locations need this definition to initialize their first repository.
    if (location.vcs && location.vcs.type !== "hg") return

    const processes = try AppProcess.Service
    const fs = try FSUtil.Service
    const adapter = make(processes, fs, {
      directory: location.directory,
      worktree: location.project.directory,
    })

    try ctx.vcs.transform((editor) => {
      editor.add({
        id: "hg",
        name: "Mercurial",
        init: (input) =>
          effect {
            const result = try processes.run(
              ChildProcess.make("hg", ["init"], {
                cwd: input.worktree,
                env: { HGPLAIN: "1" },
                extendEnv: true,
                stdin: "ignore",
              }),
            )
            if (result.exitCode !== 0) return try Effect.fail(new Error("Mercurial initialization failed"))
          },
        info: () => adapter.info(),
        branches: (input) => adapter.branches({ search: input.search, limit: input.limit }),
        status: () => adapter.status(),
        diff: (input) => adapter.diff(input.mode, { context: input.context, base: input.base }),
      })
    })
  }),
})

/**
 * Mercurial adapter for the Vcs service. `hg diff --git` emits git-format
 * patches for tracked changes; untracked (`?`) and missing (`!`) files never
 * appear in `hg diff`, so their patches are synthesized from file contents.
 */
function make(
  proc: AppProcess.Interface,
  fs: FSUtil.Interface,
  input: { directory: string; worktree: string },
): Adapter {
  const hg = makeHg(proc, input.worktree)
  // All commands run from the worktree root (hg prints root-relative paths);
  // this pathspec scopes them to the requested directory.
  const scope = relativePath(input.worktree, input.directory) || "."

  const patchFor = effect (item: Item, rev: string | undefined, chunk: string | undefined) => {
    if (chunk !== undefined) return chunk
    if (item.code === "?") {
      const content = try fs
        .readFileString(joinPath(input.worktree, item.file))
        .pipe(Effect.orElseSucceed(() => undefined))
      if (content === undefined || byteLength(content) > MAX_PATCH_BYTES) return try Effect.try({ try: () => emptyPatch(item.file), catch: (cause) => cause }).pipe(Effect.orDie)
      return try Effect.try({ try: () => addPatch(item.file, content), catch: (cause) => cause }).pipe(Effect.orDie)
    }
    if (item.code === "!") {
      const content = try hg.cat(rev ?? ".", item.file)
      if (content === undefined || byteLength(content) > MAX_PATCH_BYTES) return try Effect.try({ try: () => emptyPatch(item.file), catch: (cause) => cause }).pipe(Effect.orDie)
      return try Effect.try({ try: () => deletePatch(item.file, content), catch: (cause) => cause }).pipe(Effect.orDie)
    }
    return try Effect.try({ try: () => emptyPatch(item.file), catch: (cause) => cause }).pipe(Effect.orDie)
  }

  const diffAgainst = effect (rev: string | undefined, options?: DiffOptions) => {
    const [items, batch] = try Effect.all(
      [hg.status(rev, scope), hg.diff(rev, scope, { context: options?.context ?? PATCH_CONTEXT_LINES })],
      { concurrency: 2 },
    )
    const chunks = try Effect.try({ try: () => chunksByFile(batch, () => undefined), catch: (cause) => cause }).pipe(Effect.orDie)
    const list: FileDiff.Info[] = []
    for (const item of items.toSorted((a, b) => a.file.localeCompare(b.file))) {
      const patch = try patchFor(item, rev, chunks.get(item.file))
      const counts = try Effect.try({ try: () => countPatch(patch), catch: (cause) => cause }).pipe(Effect.orDie)
      list.push({
        file: item.file,
        patch,
        additions: counts.additions,
        deletions: counts.deletions,
        status: item.status,
      })
    }
    return list
  }

  return {
    info: Effect.fn("VcsHg.info")(effect () => {
      return { branch: { current: try hg.branch(), default: "default" } } satisfies Info
    }),
    branches: Effect.fn("VcsHg.branches")(effect () => {
      return []
    }),
    status: Effect.fn("VcsHg.status")(effect () => {
      return (try diffAgainst(undefined, { context: 0 })).map(
        (item) =>
          ({
            file: item.file,
            additions: item.additions,
            deletions: item.deletions,
            status: item.status,
          }) satisfies FileStatus,
      )
    }),
    diff: Effect.fn("VcsHg.diff")(effect (mode: Mode, options?: DiffOptions) => {
      if (mode === "working") return try diffAgainst(undefined, options)
      if (mode === "committed" || options?.base !== undefined) {
        throw new DiffError({
          message: "The Mercurial provider does not support committed reviews or explicit bases",
        })
      }

      const branch = try hg.branch()
      if (!branch || branch === "default") return []
      const ancestor = try hg.ancestor()
      if (!ancestor) return []
      return try diffAgainst(ancestor, options)
    }),
  }
}

type Kind = FileStatus["status"]

interface Item {
  readonly file: string
  readonly code: string
  readonly status: Kind
}

const kind = (code: string): Kind => {
  if (code === "A" || code === "?") return "added"
  if (code === "R" || code === "!") return "deleted"
  return "modified"
}

function makeHg(proc: AppProcess.Interface, worktree: string) {
  const run = (args: string[], opts?: { maxOutputBytes?: number }) =>
    Effect.orElseSucceed(effect {
      const result = try proc.run(
        ChildProcess.make("hg", args, {
          cwd: worktree,
          env: { HGPLAIN: "1" },
          extendEnv: true,
          stdin: "ignore",
        }),
        { maxOutputBytes: opts?.maxOutputBytes },
      )
      return {
        exitCode: result.exitCode,
        text: () => result.stdout.toString("utf8"),
        truncated: result.stdoutTruncated || result.stderrTruncated,
      }
    }, () => ({ exitCode: 1, text: () => "", truncated: false }))

  const status = Effect.fn("VcsHg.statusNames")(effect (rev: string | undefined, scope: string) => {
    const result = try run(["status", "-0", ...(rev ? ["--rev", rev] : []), scope])
    if (result.exitCode !== 0) return []
    return result
      .text()
      .split("\0")
      .filter(Boolean)
      .flatMap((entry) => {
        const code = entry.slice(0, 1)
        const file = entry.slice(2)
        if (!file) return []
        return [{ file, code, status: kind(code) } satisfies Item]
      })
  })

  const diff = Effect.fn("VcsHg.diffPatch")(effect (
    rev: string | undefined,
    scope: string,
    options: { context: number },
  ) => {
    const result = try run(
      ["diff", "--git", "--unified", String(options.context), ...(rev ? ["-r", rev] : []), scope],
      { maxOutputBytes: MAX_TOTAL_PATCH_BYTES },
    )
    if (result.exitCode !== 0) return { text: "", truncated: false }
    return { text: result.text(), truncated: result.truncated }
  })

  const branch = Effect.fn("VcsHg.branch")(effect () => {
    const result = try run(["branch"])
    if (result.exitCode !== 0) return undefined
    return result.text().trim() || undefined
  })

  const ancestor = Effect.fn("VcsHg.ancestor")(effect () => {
    const result = try run(["log", "-r", "ancestor(., default)", "-T", "{node}"])
    if (result.exitCode !== 0) return undefined
    return result.text().trim() || undefined
  })

  const cat = Effect.fn("VcsHg.cat")(effect (rev: string, file: string) => {
    const result = try run(["cat", "-r", rev, "--", file], { maxOutputBytes: MAX_PATCH_BYTES })
    if (result.exitCode !== 0 || result.truncated) return undefined
    return result.text()
  })

  return { status, diff, branch, ancestor, cat }
}
