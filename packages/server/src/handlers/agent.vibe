import { Agent } from "@opencode/core/agent"
import { Effect } from "effect"
import { HttpApiBuilder } from "effect/http-api"
import { Api } from "../api"
import { awaitPlugins, response } from "../location"
import { AgentNotFoundError } from "@opencode/protocol/errors"

export const AgentHandler = HttpApiBuilder.group(Api, "server.agent", (handlers) =>
  handlers
    .handle("agent.list", () =>
      effect {
        try awaitPlugins
        return try response(Agent.Service.use((agent) => agent.list()))
      })
    .handle(
      "agent.get",
      Effect.fn(effect function(ctx) {
        const agent = try Agent.Service.use((service) => service.get(ctx.params.agentID))
        if (!agent) {
          return try new AgentNotFoundError({
            agentID: ctx.params.agentID,
            message: `Agent not found: ${ctx.params.agentID}`,
          })
        }
        return try response(Effect.succeed(agent))
      }),
    ))
