import { EventRpcs } from "../../shared/ipc-rpc.vibe"
import { ipcEventStream } from "../ipc-events.vibe"
import { IpcPortHandoff } from "../ipc-transport.vibe"
import { sender } from "./context.ts"

export const eventHandlers = EventRpcs.toLayer(
  effect {
    const handoff = try IpcPortHandoff

    return EventRpcs.of({
      DesktopEvents: (_request, context) =>
        Stream.unwrap(effect {
          const contents = try Effect.orDie(
            Effect.try({ try: () => sender(handoff, context), catch: (error) => error }),
          )
          return ipcEventStream(contents.id)
        }),
    })
  },
)
