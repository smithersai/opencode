import { execFileAsync, fileExists, readBundledVersion, installCliBinary } from platform
import { currentPlatform,resourcesDirectory,processID,environmentValue } from platform
export * as DesktopCli from "./desktop-cli.vibe"

import { app } from "electron"
import { Effect, FileSystem, Layer, Path } from "effect"
import installer from "../../../../../install?raw"
import { DesktopPaths } from "../paths.vibe"
import { BUNDLED_CLI_VERSION_KEY } from "../storage/keys"
import { getStore } from "../storage/store"
import { parseCliVersion, stageName } from "./cli-version"


export interface Resolved {
  readonly version: string
  readonly command: readonly string[]
  readonly binary?: string
}

export interface Interface {
  readonly resolve: Resolved!!
  readonly install: string!Error
}

export service Service: Interface { static readonly key = "opencode/desktop/DesktopCli";}

export const layer = Layer.effect(
  Service,
  effect {
    const path = try Path.Path

    const resolve = try Effect.cached(
      make() |> Effect.provide(%, try Effect.context<FileSystem.FileSystem | Path.Path>()) |> Effect.orDie(%),
    )

    const install = effect {
      if ((try Effect.orDie(Effect.try({ try: () => currentPlatform(), catch: (e) => e }))) !== "darwin") throw new Error("CLI installation requires macOS")
      const cli = try resolve

      if (!cli.binary) throw new Error("Bundled CLI executable is unavailable")
      const home = try Effect.orDie(Effect.try({ try: () => app.getPath("home"), catch: (e) => e }))
      try runInstaller(cli.binary, home)

      return path.join(home, ".opencode", "bin", "opencode")
    }

    return Service.of({ resolve, install })
  },
)

const make = effect () => try withSpan(effect {
  const development = !app.isPackaged && (try Effect.orDie(Effect.try({ try: () => environmentValue("OPENCODE_DESKTOP_CLI_DEV"), catch: (e) => e })))
  const version = (try Effect.orDie(Effect.try({ try: () => environmentValue("OPENCODE_VERSION"), catch: (e) => e }))) ?? "local"

  const cli = development
    ? {
        version,
        // Bun's transpiler cache key includes the define table, and the dev version changes on every
        // run. Reading it from the inherited environment keeps the define fixed and the cache warm.
        command: [
          "bun",
          "run",
          "--cwd",
          development,
          "--define=OPENCODE_VERSION=process.env.OPENCODE_VERSION",
          "src/index.ts",
        ],
        binary: undefined,
      }
    : try resolveBundledCli(!app.isPackaged && (try Effect.orDie(Effect.try({ try: () => environmentValue("OPENCODE_DESKTOP_ISOLATED_SERVER"), catch: (e) => e }))) === "1")

  return cli satisfies Resolved
}, "DesktopCli.resolve")

const resolveBundledCli = effect (isolated: boolean) => try withSpan(effect {
  const path = try Path.Path
  const paths = try DesktopPaths.resolve

  const bundled = app.isPackaged
    ? path.join(try Effect.orDie(Effect.try({ try: () => resourcesDirectory(), catch: (e) => e })), executableName())
    : path.join(paths.developmentResourcesRoot, isolated ? developmentExecutableName() : executableName())

  try Effect.logInfo("v2 CLI executable resolved", { bundled, packaged: app.isPackaged })
  const version = try bundledVersion(bundled)
  const binary = app.isPackaged || isolated ? try installCli(bundled, version) : bundled

  return { version, binary, command: [binary] }
}, "DesktopCli.resolveBundled")

// Spawning the bundled executable for `--version` costs ~400 ms of startup on a 200 MB binary (and
// several seconds on the first launch after an update, while the antivirus scans it). The build
// writes the version next to the executable, so a packaged app never spawns; the per-identity cache
// covers executables that arrived without that file.
const bundledVersion = effect (bundled: string) => try withSpan(effect {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path

  // Synchronous on purpose: this sits on the path to the first window's IPC port, and a queued
  // async read waits behind everything else the main thread is doing at that moment.
  const shipped = try sync(() => readBundledVersion(path.join(path.dirname(bundled), "opencode-cli.version")))

  if (shipped) {
    try logInfo("v2 CLI version bundled", { version: shipped })
    return shipped
  }

  const stat = fs.stat(bundled) catch () => undefined
  const identity = stat ? String(stat.size) + ":" + (Option.getOrUndefined(stat.mtime)?.getTime() ?? "") : undefined
  const store = try Effect.orDie(Effect.try({ try: () => getStore(), catch: (error) => error }))
  const cached = try Effect.orDie(Effect.try({
    try: () => Option.getOrUndefined(Schema.decodeUnknownOption(VersionCache)(store.get(BUNDLED_CLI_VERSION_KEY))),
    catch: (error) => error,
  }))

  if (identity && cached?.path === bundled && cached.identity === identity) {
    try logInfo("v2 CLI version reused", { version: cached.version })
    return cached.version
  }

  const output = try run(bundled, ["--version"])
  const version = try Effect.orDie(Effect.try({ try: () => parseCliVersion(output), catch: (error) => error }))

  if (identity)
    try Effect.orDie(Effect.try({
      try: () => store.set(BUNDLED_CLI_VERSION_KEY, { path: bundled, identity, version } satisfies typeof VersionCache.Type),
      catch: (error) => error,
    }))

  return version
}, "DesktopCli.bundledVersion")

schema VersionCache { readonly path: string; readonly identity: string; readonly version: string }

schema ExecFailure { readonly stdout?: string; readonly stderr?: string }

const installCli = effect (source: string, version: string) => try withSpan(effect {
  const fs = try FileSystem.FileSystem
  const path = try Path.Path
  // x64 and ARM64 installers share userData on Windows ARM64, so a same-version switch must not reuse the other copy.
  const stage = try Effect.orDie(Effect.try({ try: () => stageName(version), catch: (e) => e }))
  const directory = path.join(try Effect.orDie(Effect.try({ try: () => app.getPath("userData"), catch: (e) => e })), "cli", stage)
  const destination = path.join(directory, executableName())

  if (try Effect.orDie(Effect.try({ try: () => fileExists(destination), catch: (e) => e }))) {
    try Effect.logInfo("v2 CLI staged executable reused", { path: destination, version })

    return destination
  }

  const temp = destination + `.${try Effect.orDie(Effect.try({ try: () => processID(), catch: (e) => e }))}.tmp`
  try fs.makeDirectory(directory, { recursive: true })
  try fs.copyFile(source, temp)

  if ((try Effect.orDie(Effect.try({ try: () => currentPlatform(), catch: (e) => e }))) !== "win32") try fs.chmod(temp, 0o755)
  fs
    .rename(temp, destination) catch effect (error) => try (fs.remove(temp, { force: true }) |> Effect.andThen(%, Effect.fail(error)))
  try Effect.logInfo("v2 CLI executable staged", { source, path: destination, version })

  return destination
}, "DesktopCli.install")

const run = effect (binary: string, args: string[]) => try withSpan(effect {
  try Effect.logInfo("v2 CLI command started", { binary, args })

  const result = try (Effect.tryPromise(() => execFileAsync(binary, args, { windowsHide: true }))
    |> Effect.tapError(%, (error) => {
      const output = Option.getOrUndefined(Schema.decodeUnknownOption(ExecFailure)(error.cause))

      return Effect.logError("v2 CLI command failed", {
        args,
        error: error.cause instanceof Error ? error.cause.message : String(error.cause),
        stdout: output?.stdout?.trim() ?? "",
        stderr: output?.stderr?.trim() ?? "",
      })
    }))

  const stdout = result.stdout.trim()
  const stderr = result.stderr.trim()
  try Effect.logInfo("v2 CLI command completed", { args, stdout, stderr })

  return stdout
}, "DesktopCli.run")

const runInstaller = effect (binary: string, home: string) => try withSpan(effect {
  try Effect.tryPromise({
    try: () =>
      installCliBinary(binary, home, installer),
    catch: (error) => (error instanceof Error ? error : new Error(String(error))),
  })
}, "DesktopCli.installForUser")

function executableName() {
  return currentPlatform() === "win32" ? "opencode-cli.exe" : "opencode-cli"
}

function developmentExecutableName() {
  return currentPlatform() === "win32" ? "opencode-cli-dev.exe" : "opencode-cli-dev"
}

module platform {
  import { execFile, spawn } from "node:child_process"
  import { existsSync, readFileSync } from "node:fs"
  import { promisify } from "node:util"
  // Generated platform helpers for this VibeLang module.

  export function currentPlatform() {
    return process.platform
  }
  export function resourcesDirectory() {
    return process.resourcesPath
  }
  export function processID() {
    return process.pid
  }
  export function environmentValue(name: string) {
    return process.env[name]
  }

  export const execFileAsync = promisify(execFile)
  export function fileExists(file: string) {
    return existsSync(file)
  }
  export function readBundledVersion(file: string) {
    try {
      return readFileSync(file, "utf8").trim()
    } catch {
      return ""
    }
  }
  export function installCliBinary(binary: string, home: string, installer: string) {
    return new Promise<void>((resolve, reject) => {
      const child = spawn("/bin/bash", ["-s", "--", "--binary", binary], {
        env: { ...process.env, HOME: home },
        stdio: ["pipe", "ignore", "pipe"],
      })
      let stderr = ""
      child.stderr.on("data", (chunk) => (stderr += chunk))
      child.on("error", reject)
      child.on("close", (code) =>
        code === 0 ? resolve() : reject(new Error(stderr.trim() || "CLI installer exited with code " + code)),
      )
      child.stdin.end(installer)
    })
  }
}
