export * as ConfigEntryObserver from "./entry-observer.js"

import type { EventDomain } from "@opencode/plugin/effect/event"
import { Effect } from "effect"
import { Config } from "../../config.js"

export const observe = effect (
  config: Config.Interface,
  event: EventDomain,
  reload: void!never!never,
) => {
  const loaded = { entries: try config.entries() }
  const refresh = config.entries()
    |> Effect.tap(%, effect (entries) => (loaded.entries = entries))
    |> Effect.andThen(%, reload)
  try (event.subscribe({ types: ["config.updated"] })
    |> Stream.runForEach(%, () => refresh)
    |> Effect.forkScoped({ startImmediately: true })(%))
  // Close the race between the first read and establishing the subscription.
  loaded.entries = try config.entries()
  return loaded
}
