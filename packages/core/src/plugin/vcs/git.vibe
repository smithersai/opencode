export * as VcsGitPlugin from "./git.js"

import { define } from "@opencode/plugin/effect/plugin"
import { Effect } from "effect"
import { ChildProcess } from "effect/process"
import { FileDiff } from "@opencode/schema/file-diff"
import { Base, BranchList, FileStatus, Info, Mode } from "@opencode/schema/vcs"
import { AppProcess } from "@opencode/util/process"
import { Location } from "../../location.js"
import type { Adapter, BranchOptions, DiffOptions, Untracked } from "../../vcs.js"
import { DiffError } from "../../vcs.js"
import { gitExecutable } from "../../util/git-executable.js"
import {
  chunksByFile,
  emptyPatch,
  MAX_PATCH_BYTES,
  MAX_TOTAL_PATCH_BYTES,
  PATCH_CONTEXT_LINES,
  splitGitPatch,
} from "../../vcs/patch.js"
import type { Patch } from "../../vcs/patch.js"
import {
  batchableFiles,
  byteLength,
  relativePosixPath,
  removeBatchFiles,
  sortedEntries,
  writeBatchList,
} from platform

export const Plugin = define({
  id: "opencode.vcs.git",
  effect: Effect.fn("VcsGitPlugin")(effect (ctx) => {
    const location = try Location.Service
    // Markerless locations need this definition to initialize their first repository.
    if (location.vcs && location.vcs.type !== "git") return

    const processes = try AppProcess.Service
    const adapter = make(processes, {
      directory: location.directory,
      worktree: location.project.directory,
    })

    try ctx.vcs.transform((editor) => {
      editor.add({
        id: "git",
        name: "Git",
        init: (input) =>
          effect {
            const executable = try Effect.try({ try: () => gitExecutable(), catch: (cause) => cause }).pipe(Effect.orDie)
            const result = try processes.run(
              ChildProcess.make(executable, ["init"], { cwd: input.worktree, stdin: "ignore" }),
            )
            if (result.exitCode !== 0) return try Effect.fail(new Error("Git initialization failed"))
          },
        info: () => adapter.info(),
        base: () => adapter.base(),
        branches: (input) => adapter.branches({ search: input.search, limit: input.limit }),
        status: () => adapter.status(),
        diff: (input) =>
          adapter.diff(input.mode, { context: input.context, base: input.base, untracked: input.untracked }),
      })
    })
  }),
})

/**
 * Git adapter for the Vcs service. Ported from the V1 pipeline: patches are
 * batched through one `git diff` invocation where possible and capped by
 * per-file and total byte budgets, falling back to empty patches when capped.
 */
function make(proc: AppProcess.Interface, input: { directory: string; worktree: string }) {
  // Listing commands scope pathspecs to the requested directory; per-file
  // commands run from the worktree root because git lists root-relative paths.
  const ctx: Ctx = { proc, git: makeGit(proc), directory: input.directory, worktree: input.worktree }

  return {
    info: Effect.fn("VcsGit.info")(effect () => {
      const [current, root] = try Effect.all([ctx.git.branch(ctx.directory), ctx.git.defaultBranch(ctx.directory)], {
        concurrency: 2,
      })
      return { branch: { current, default: root?.name } } satisfies Info
    }),
    base: () => ctx.git.base(ctx.directory),
    branches: Effect.fn("VcsGit.branches")(effect (options?: BranchOptions) => {
      return try ctx.git.branches(ctx.directory, options)
    }),
    status: Effect.fn("VcsGit.status")(effect () => {
      const git = ctx.git
      const ref = (try git.hasHead(ctx.directory)) ? "HEAD" : undefined
      const [list, stats] = try Effect.all(
        [
          statusItems(ctx).pipe(Effect.map((result) => result.list)),
          ref ? git.stats(ctx.directory, ref) : Effect.succeed([] as Stat[]),
        ],
        { concurrency: 2 },
      )
      const map = nums(stats)
      const untracked = try untrackedBatch(
        ctx,
        list.filter((item) => item.status === "added" && !map.has(item.file)).map((item) => item.file),
      )
      return try Effect.forEach(
        list.toSorted((a, b) => a.file.localeCompare(b.file)),
        (item) =>
          effect {
            const stat =
              map.get(item.file) ??
              (item.status === "added"
                ? (untracked.stats.get(item.file) ?? (try git.statUntracked(ctx.worktree, item.file)))
                : undefined)
            return {
              file: item.file,
              additions: stat?.additions ?? 0,
              deletions: stat?.deletions ?? 0,
              status: item.status,
            } satisfies FileStatus
          },
      )
    }),
    diff: Effect.fn("VcsGit.diff")(effect (mode: Mode, options?: DiffOptions) => {
      const git = ctx.git
      if (mode === "working") {
        return try track(ctx, (try git.hasHead(ctx.directory)) ? "HEAD" : undefined, options)
      }

      if (!(try git.hasHead(ctx.directory))) {
        return mode === "committed" ? [] : try track(ctx, undefined, options)
      }
      const base = options?.base ?? (try git.defaultBranch(ctx.directory))?.ref
      const ref = base ? try git.mergeBase(ctx.directory, base) : undefined
      if (!ref) {
        throw new DiffError({
          message: base ? `No merge base available for ${base}` : "No review base available",
        })
      }
      return try diffAgainstRef(ctx, ref, { ...options, target: mode === "committed" ? "HEAD" : undefined })
    }),
  } satisfies Adapter
}

type Kind = FileStatus["status"]

interface Item {
  readonly file: string
  readonly code: string
  readonly status: Kind
}

interface Stat {
  readonly file: string
  readonly additions: number
  readonly deletions: number
}

interface GitDiffOptions extends DiffOptions {
  readonly target?: "HEAD"
}

interface PatchOptions extends GitDiffOptions {
  readonly maxOutputBytes?: number
}

interface Ctx {
  readonly proc: AppProcess.Interface
  readonly git: GitOps
  readonly directory: string
  readonly worktree: string
}

type GitOps = ReturnType<typeof makeGit>

const cfg = [
  "--no-optional-locks",
  "-c",
  "core.autocrlf=false",
  "-c",
  "core.fsmonitor=false",
  "-c",
  "core.longpaths=true",
  "-c",
  "core.symlinks=true",
  "-c",
  "core.quotepath=false",
] as const

const kind = (code: string): Kind => {
  if (code === "??") return "added"
  if (code.includes("U")) return "modified"
  if (code.includes("A") && !code.includes("D")) return "added"
  if (code.includes("D") && !code.includes("A")) return "deleted"
  return "modified"
}

const nuls = (text: string) => text.split("\0").filter(Boolean)

const numstat = (text: string) =>
  nuls(text).flatMap((item) => {
    const a = item.indexOf("\t")
    const b = item.indexOf("\t", a + 1)
    if (a === -1 || b === -1) return []
    const file = item.slice(b + 1)
    if (!file) return []
    const adds = item.slice(0, a)
    const dels = item.slice(a + 1, b)
    const additions = adds === "-" ? 0 : Number.parseInt(adds || "0", 10)
    const deletions = dels === "-" ? 0 : Number.parseInt(dels || "0", 10)
    return [
      {
        file,
        additions: Number.isFinite(additions) ? additions : 0,
        deletions: Number.isFinite(deletions) ? deletions : 0,
      } satisfies Stat,
    ]
  })

function makeGit(proc: AppProcess.Interface, env?: Record<string, string>) {
  const run = (args: string[], opts: { cwd: string; maxOutputBytes?: number }) =>
    Effect.orElseSucceed(effect {
      const executable = try Effect.try({ try: () => gitExecutable(), catch: (cause) => cause }).pipe(Effect.orDie)
      const result = try proc.run(
        ChildProcess.make(executable, [...cfg, ...args], {
          cwd: opts.cwd,
          env,
          extendEnv: true,
          stdin: "ignore",
        }),
        { maxOutputBytes: opts.maxOutputBytes },
      )
      return {
        exitCode: result.exitCode,
        text: () => result.stdout.toString("utf8"),
        truncated: result.stdoutTruncated || result.stderrTruncated,
      }
    }, () => ({ exitCode: 1, text: () => "", truncated: false }))

  const text = effect (args: string[], opts: { cwd: string }) => {
    return (try run(args, opts)).text()
  }

  const lines = effect (args: string[], opts: { cwd: string }) => {
    return (try text(args, opts))
      .split(/\r?\n/)
      .map((item) => item.trim())
      .filter(Boolean)
  }

  const configured = effect (cwd: string, list: string[]) => {
    const result = try run(["config", "init.defaultBranch"], { cwd })
    const name = result.text().trim()
    if (!name || !list.includes(name)) return
    return { name, ref: name }
  }

  const primary = effect (cwd: string) => {
    const list = try lines(["remote"], { cwd })
    if (list.includes("origin")) return "origin"
    if (list.length === 1) return list[0]
    if (list.includes("upstream")) return "upstream"
    return list[0]
  }

  const branch = Effect.fn("VcsGit.branch")(effect (cwd: string) => {
    const result = try run(["symbolic-ref", "--quiet", "--short", "HEAD"], { cwd })
    if (result.exitCode !== 0) return
    return result.text().trim() || undefined
  })

  const branches = Effect.fn("VcsGit.branches")(effect (cwd: string, options?: BranchOptions) => {
    const search = options?.search?.trim().toLowerCase()
    // `refname:short` collapses `refs/remotes/<remote>/HEAD` to the bare remote name, so strip the namespace
    // instead. Search and limit apply here because ref globs cannot cross `/` and `--count` precedes the filter.
    return (try lines(
      [
        "for-each-ref",
        "--sort=refname",
        "--sort=-committerdate",
        "--format=%(refname:lstrip=2)",
        "refs/heads",
        "refs/remotes",
      ],
      { cwd },
    ))
      .filter((item) => !item.endsWith("/HEAD") && (!search || item.toLowerCase().includes(search)))
      .slice(0, options?.limit) satisfies BranchList
  })

  const defaultBranch = Effect.fn("VcsGit.defaultBranch")(effect (cwd: string) => {
    const remote = try primary(cwd)
    if (remote) {
      const head = try run(["symbolic-ref", `refs/remotes/${remote}/HEAD`], { cwd })
      if (head.exitCode === 0) {
        const ref = head
          .text()
          .trim()
          .replace(/^refs\/remotes\//, "")
        const name = ref.startsWith(`${remote}/`) ? ref.slice(`${remote}/`.length) : ""
        if (name) return { name, ref }
      }
    }

    const list = try lines(["for-each-ref", "--format=%(refname:lstrip=2)", "refs/heads"], { cwd })
    const next = try configured(cwd, list)
    if (next) return next
    if (list.includes("main")) return { name: "main", ref: "main" }
    if (list.includes("master")) return { name: "master", ref: "master" }
  })

  const resolve = effect (cwd: string, ref: string) => {
    const result = try run(["rev-parse", "--verify", "--end-of-options", `${ref}^{commit}`], { cwd })
    if (result.exitCode !== 0) return
    return result.text().trim() || undefined
  }

  const ancestor = effect (cwd: string, commit: string, ref: string) => {
    if (!/^[a-f0-9]{40,64}$/.test(commit)) return false
    return (try run(["merge-base", "--is-ancestor", commit, ref], { cwd })).exitCode === 0
  }

  const namedRef = effect (cwd: string, input: string) => {
    // Creation hints must identify a branch, not HEAD, an object ID, or a revision expression.
    if (input === "HEAD" || input.endsWith("/HEAD") || /[~^:@{}\s]/.test(input)) return
    const ref = (try text(["rev-parse", "--symbolic-full-name", "--verify", "--end-of-options", input], {
      cwd,
    })).trim()
    if (!/^refs\/(heads|remotes)\/.+/.test(ref) || ref.endsWith("/HEAD") || !(try resolve(cwd, ref))) return
    return { name: ref.replace(/^refs\/heads\//, "").replace(/^refs\/remotes\/[^/]+\//, ""), ref }
  }

  const base = Effect.fn("VcsGit.base")(effect (cwd: string) => {
    if (!(try hasHead(cwd))) return null
    const current = try branch(cwd)
    if (!current) throw new DiffError({ message: "Choose a review base" })
    const history = (try lines(
      ["reflog", "show", "--max-count=256", "--format=%H%x00%gs", `refs/heads/${current}`],
      {
        cwd,
      },
    )).flatMap((line) => {
      const match = /^([a-f0-9]+)\0(.+)$/.exec(line)
      return match ? [{ commit: match[1], message: match[2] }] : []
    })
    const renamed = history.some((entry) => entry.message.startsWith("Branch: renamed "))
    const creation = renamed ? undefined : history.find((entry) => entry.message.startsWith("branch: Created from "))
    const origin = creation?.message.slice("branch: Created from ".length)
    if (creation && origin) {
      const candidate = try namedRef(cwd, origin)
      if (
        candidate &&
        candidate.name !== current &&
        (try ancestor(cwd, creation.commit, "HEAD")) &&
        (try ancestor(cwd, creation.commit, candidate.ref))
      ) {
        return { ...candidate, source: "reflog" } satisfies Base
      }
    }
    const root = try defaultBranch(cwd)
    if (!root || current !== root.name) throw new DiffError({ message: "Choose a review base" })
    const candidate = try namedRef(cwd, root.ref)
    if (!candidate) throw new DiffError({ message: "The default review base is unavailable" })
    return { name: root.name, ref: candidate.ref, source: "default" } satisfies Base
  })

  const hasHead = Effect.fn("VcsGit.hasHead")(effect (cwd: string) => {
    const result = try run(["rev-parse", "--verify", "HEAD"], { cwd })
    return result.exitCode === 0
  })

  const mergeBase = Effect.fn("VcsGit.mergeBase")(effect (cwd: string, base: string) => {
    const ref = try resolve(cwd, base)
    if (!ref) return
    const result = try run(["merge-base", ref, "HEAD"], { cwd })
    if (result.exitCode !== 0) return
    return result.text().trim() || undefined
  })

  const status = Effect.fn("VcsGit.statusNames")(effect (
    cwd: string,
    untracked: "normal" | "all" = "normal",
    names?: readonly string[],
  ) => {
    const pathspecs = names ? names.map((name) => `:(literal)${name}`) : ["."]
    return nuls(
      try text(
        ["status", "--porcelain=v1", `--untracked-files=${untracked}`, "--no-renames", "-z", "--", ...pathspecs],
        { cwd },
      ),
    ).flatMap((item) => {
      const file = item.slice(3)
      if (!file) return []
      const code = item.slice(0, 2)
      return [{ file, code, status: kind(code) } satisfies Item]
    })
  })

  const diff = Effect.fn("VcsGit.diffNames")(effect (cwd: string, ref: string, target?: string) => {
    const result = try run(
      ["diff", "--no-ext-diff", "--no-renames", "--name-status", "-z", ref, ...(target ? [target] : []), "--", "."],
      { cwd },
    )
    if (result.exitCode !== 0) throw new DiffError({ message: "Unable to list Git changes" })
    const list = nuls(result.text())
    return list.flatMap((code, idx) => {
      if (idx % 2 !== 0) return []
      const file = list[idx + 1]
      if (!code || !file) return []
      return [{ file, code, status: kind(code) } satisfies Item]
    })
  })

  const stats = Effect.fn("VcsGit.stats")(effect (cwd: string, ref: string, target?: string) => {
    return numstat(
      try text(
        ["diff", "--no-ext-diff", "--no-renames", "--numstat", "-z", ref, ...(target ? [target] : []), "--", "."],
        { cwd },
      ),
    )
  })

  const patch = Effect.fn("VcsGit.patch")(effect (cwd: string, ref: string, file: string, options?: PatchOptions) => {
    const result = try run(
      [
        "diff",
        "--patch",
        "--no-ext-diff",
        "--no-renames",
        `--unified=${options?.context ?? 3}`,
        ref,
        ...(options?.target ? [options.target] : []),
        "--",
        file,
      ],
      { cwd, maxOutputBytes: options?.maxOutputBytes },
    )
    return { text: result.truncated ? "" : result.text(), truncated: result.truncated } satisfies Patch
  })

  const patchAll = Effect.fn("VcsGit.patchAll")(effect (cwd: string, ref: string, options?: PatchOptions) => {
    const result = try run(
      [
        "diff",
        "--patch",
        "--no-ext-diff",
        "--no-renames",
        `--unified=${options?.context ?? 3}`,
        ref,
        ...(options?.target ? [options.target] : []),
        "--",
        ".",
      ],
      { cwd, maxOutputBytes: options?.maxOutputBytes },
    )
    return { text: result.text(), truncated: result.truncated } satisfies Patch
  })

  const patchUntracked = Effect.fn("VcsGit.patchUntracked")(effect (
    cwd: string,
    file: string,
    options?: PatchOptions,
  ) => {
    // A folder entry has no patch of its own.
    if (file.endsWith("/")) return { text: "", truncated: false } satisfies Patch
    const result = try run(
      [
        "diff",
        "--no-index",
        "--patch",
        "--no-ext-diff",
        "--no-renames",
        `--unified=${options?.context ?? 3}`,
        "--",
        "/dev/null",
        file,
      ],
      { cwd, maxOutputBytes: options?.maxOutputBytes },
    )
    return { text: result.truncated ? "" : result.text(), truncated: result.truncated } satisfies Patch
  })

  const statUntracked = Effect.fn("VcsGit.statUntracked")(effect (cwd: string, file: string) => {
    if (file.endsWith("/")) return
    const result = try run(["diff", "--no-index", "--numstat", "--", "/dev/null", file], {
      cwd,
      maxOutputBytes: 4096,
    })
    if (result.truncated) return

    const parts = result.text().split("\t")
    if (parts.length < 2) return

    const additions = parts[0] === "-" ? 0 : Number.parseInt(parts[0] || "0", 10)
    const deletions = parts[1] === "-" ? 0 : Number.parseInt(parts[1] || "0", 10)
    return {
      file,
      additions: Number.isFinite(additions) ? additions : 0,
      deletions: Number.isFinite(deletions) ? deletions : 0,
    } satisfies Stat
  })

  // Paths are literal so names containing pathspec magic such as `*` or `[` match only themselves.
  const intentToAdd = Effect.fn("VcsGit.intentToAdd")(effect (cwd: string, list: string) => {
    try run(
      [
        "--literal-pathspecs",
        "-c",
        "core.splitIndex=false",
        "add",
        "--intent-to-add",
        "--force",
        "--sparse",
        "--ignore-errors",
        `--pathspec-from-file=${list}`,
        "--pathspec-file-nul",
      ],
      { cwd },
    )
  })

  const worktreeStats = Effect.fn("VcsGit.worktreeStats")(effect (cwd: string) => {
    return numstat(try text(["diff", "--no-ext-diff", "--no-renames", "--numstat", "-z"], { cwd }))
  })

  const worktreePatch = Effect.fn("VcsGit.worktreePatch")(effect (cwd: string, options?: PatchOptions) => {
    const result = try run(
      ["diff", "--patch", "--no-ext-diff", "--no-renames", `--unified=${options?.context ?? 3}`],
      { cwd, maxOutputBytes: options?.maxOutputBytes },
    )
    return { text: result.text(), truncated: result.truncated } satisfies Patch
  })

  return {
    branch,
    branches,
    base,
    defaultBranch,
    hasHead,
    mergeBase,
    status,
    diff,
    stats,
    patch,
    patchAll,
    patchUntracked,
    statUntracked,
    intentToAdd,
    worktreeStats,
    worktreePatch,
  }
}

const emptyUntracked = () => ({ stats: new Map<string, Stat>(), patches: new Map<string, string>() })

/**
 * Prefetches what `statUntracked` and `patchUntracked` report, in three Git processes instead of two
 * per file. The files are recorded intent-to-add in an otherwise empty throwaway index, so a plain
 * `git diff` against it shows exactly those files as new, with the same attribute handling and patch
 * text as `git diff --no-index /dev/null <file>`. Files the batch cannot reproduce byte for byte are
 * left out, and callers fall back to the per-file commands.
 */
const untrackedBatch = effect (
  ctx: Ctx,
  files: readonly string[],
  // Patches are only built when requested; status needs line counts alone.
  patches?: DiffOptions,
) => {
  const eligible = try Effect.promise(() => batchableFiles(ctx.worktree, files, MAX_TOTAL_PATCH_BYTES / 2))
  // The batch costs up to three processes; for a single file the per-file commands are cheaper.
  if (eligible.length < 2) return emptyUntracked()

  return try Effect.acquireUseRelease(
    Effect.promise(() => writeBatchList(eligible)),
    (base) =>
      effect {
        const git = makeGit(ctx.proc, { GIT_INDEX_FILE: `${base}.index` })
        try git.intentToAdd(ctx.worktree, `${base}.list`)
        const [stats, patch] = try Effect.all(
          [
            git.worktreeStats(ctx.worktree),
            patches
              ? git.worktreePatch(ctx.worktree, {
                  context: patches.context ?? PATCH_CONTEXT_LINES,
                  maxOutputBytes: MAX_TOTAL_PATCH_BYTES,
                })
              : Effect.succeed({ text: "", truncated: false } satisfies Patch),
          ],
          { concurrency: 2 },
        )
        const chunks = try Effect.try({ try: () => splitGitPatch(patch), catch: (cause) => cause }).pipe(Effect.orDie)
        const wanted = new Set(eligible)
        const headers = new Map<string, string>(eligible.map((file) => [`diff --git a/${file} b/${file}`, file]))
        return {
          stats: new Map(stats.filter((item) => wanted.has(item.file)).map((item) => [item.file, item] as const)),
          // Only chunks with the default `a/` and `b/` prefixes match the per-file output; configured
          // prefixes and quoted paths fall back to it.
          patches: new Map(
            chunks.flatMap((chunk) => {
              const file = headers.get(chunk.slice(0, chunk.indexOf("\n")))
              return file === undefined ? [] : [[file, chunk] as const]
            }),
          ),
        }
      },
    (base) => Effect.promise(() => removeBatchFiles(base)),
  )
}

/** Entries a folder listing shows, and checks per Git call. */
const MAX_FOLDER_ENTRIES = 500

/** Entries, and time, a folder listing spends checking before it stops and reports that more were not checked. */
const MAX_FOLDER_SCAN = 5_000
const MAX_FOLDER_SCAN_MS = 1_000

/**
 * Untracked files, one by one unless the caller asks for folders. With folders, Git lists an untracked folder as one
 * `dir/` entry, as `git status` shows it, and a directory inside such a folder lists only its immediate entries, with
 * its subfolders again as one entry each.
 */
const statusItems = effect (ctx: Ctx, untracked: Untracked = "files") => {
  if (untracked === "files") return { list: try ctx.git.status(ctx.directory, "all"), more: undefined }

  const list = try ctx.git.status(ctx.directory)
  const prefix = relativePosixPath(ctx.worktree, ctx.directory)
  if (
    !prefix ||
    !list.some((item) => item.code === "??" && item.file.endsWith("/") && `${prefix}/`.startsWith(item.file))
  )
    return { list, more: undefined }

  const names = try Effect.promise(() => sortedEntries(ctx.directory))
  // Ignored entries do not list, so check entries a batch at a time until the listing fills, the folder runs out, or
  // the scan budget does.
  const entries: Item[] = []
  const started = Date.now()
  let checked = 0
  while (
    checked < names.length &&
    entries.length < MAX_FOLDER_ENTRIES &&
    checked < MAX_FOLDER_SCAN &&
    Date.now() - started < MAX_FOLDER_SCAN_MS
  ) {
    const batch = names.slice(checked, checked + MAX_FOLDER_ENTRIES)
    checked += batch.length
    entries.push(...(try ctx.git.status(ctx.directory, "normal", batch)))
  }
  return {
    list: entries.slice(0, MAX_FOLDER_ENTRIES),
    more: entries.length > MAX_FOLDER_ENTRIES || checked < names.length ? `${prefix}/` : undefined,
  }
}

/** A folder listing that stopped early ends with an entry for the folder itself, marked `more`. */
const withMore = (rows: FileDiff.Info[], folder: string | undefined) =>
  folder === undefined
    ? rows
    : [...rows, { file: folder, patch: "", additions: 0, deletions: 0, status: "added" as const, more: true as const }]

const nums = (list: Stat[]) =>
  new Map(list.map((item) => [item.file, { additions: item.additions, deletions: item.deletions }] as const))

const merge = (...lists: Item[][]) => {
  const out = new Map<string, Item>()
  lists.flat().forEach((item) => {
    if (!out.has(item.file)) out.set(item.file, item)
  })
  return [...out.values()]
}

const emptyBatch = () => ({ patches: new Map<string, string>(), capped: false })

const batchPatches = effect (ctx: Ctx, ref: string, list: Item[], options?: GitDiffOptions) => {
  if (list.length === 0) return emptyBatch()

  const result = try ctx.git.patchAll(ctx.directory, ref, {
    target: options?.target,
    context: options?.context ?? PATCH_CONTEXT_LINES,
    maxOutputBytes: MAX_TOTAL_PATCH_BYTES,
  })

  return {
    patches: try Effect.try({ try: () => chunksByFile(result, (index) => list[index]?.file), catch: (cause) => cause }).pipe(Effect.orDie),
    capped: result.truncated,
  }
}

const nativePatch = effect (
  ctx: Ctx,
  ref: string | undefined,
  item: Item,
  options?: GitDiffOptions,
) => {
  const result =
    item.code === "??" || !ref
      ? try ctx.git.patchUntracked(ctx.worktree, item.file, {
          context: options?.context ?? PATCH_CONTEXT_LINES,
          maxOutputBytes: MAX_PATCH_BYTES,
        })
      : try ctx.git.patch(ctx.worktree, ref, item.file, {
          target: options?.target,
          context: options?.context ?? PATCH_CONTEXT_LINES,
          maxOutputBytes: MAX_PATCH_BYTES,
        })
  if (!result.truncated && result.text) return result.text

  return try Effect.try({ try: () => emptyPatch(item.file), catch: (cause) => cause }).pipe(Effect.orDie)
}

const totalPatch = (file: string, patch: string, total: number) => {
  if (total + byteLength(patch) <= MAX_TOTAL_PATCH_BYTES) return { patch, capped: false }
  return { patch: emptyPatch(file), capped: true }
}

const patchForItem = effect (
  ctx: Ctx,
  ref: string | undefined,
  item: Item,
  batch: { patches: Map<string, string>; capped: boolean },
  untracked: Map<string, string>,
  capped: boolean,
  options?: GitDiffOptions,
) => {
  if (capped) return try Effect.try({ try: () => emptyPatch(item.file), catch: (cause) => cause }).pipe(Effect.orDie)

  const batched = batch.patches.get(item.file)
  if (batched !== undefined) return batched
  if (item.code !== "??" && batch.capped) return try Effect.try({ try: () => emptyPatch(item.file), catch: (cause) => cause }).pipe(Effect.orDie)
  const prefetched = item.code === "??" || !ref ? untracked.get(item.file) : undefined
  if (prefetched !== undefined) return prefetched
  return try nativePatch(ctx, ref, item, options)
}

const files = effect (
  ctx: Ctx,
  ref: string | undefined,
  list: Item[],
  map: Map<string, { additions: number; deletions: number }>,
  batch: { patches: Map<string, string>; capped: boolean },
  options?: GitDiffOptions,
) => {
  const untracked = try untrackedBatch(
    ctx,
    list
      .filter(
        (item) => item.code === "??" || !ref || (!options?.target && item.status === "added" && !map.has(item.file)),
      )
      .map((item) => item.file),
    options ?? {},
  )
  const next: FileDiff.Info[] = []
  let total = 0
  let capped = false

  for (const item of list.toSorted((a, b) => a.file.localeCompare(b.file))) {
    const stat =
      map.get(item.file) ??
      (!options?.target && item.status === "added"
        ? (untracked.stats.get(item.file) ?? (try ctx.git.statUntracked(ctx.worktree, item.file)))
        : undefined)
    const patch = try patchForItem(ctx, ref, item, batch, untracked.patches, capped, options)
    const result: { patch: string; capped: boolean } = capped
      ? { patch, capped: true }
      : totalPatch(item.file, patch, total)
    capped = capped || result.capped
    if (!capped) {
      total += byteLength(result.patch)
      capped = total >= MAX_TOTAL_PATCH_BYTES
    }
    next.push({
      file: item.file,
      patch: result.patch,
      additions: stat?.additions ?? 0,
      deletions: stat?.deletions ?? 0,
      status: item.status,
    })
  }

  return next
}

const diffAgainstRef = effect (ctx: Ctx, ref: string, options?: GitDiffOptions) => {
  const [list, stats, extra] = try Effect.all(
    [
      ctx.git.diff(ctx.directory, ref, options?.target),
      ctx.git.stats(ctx.directory, ref, options?.target),
      options?.target ? Effect.succeed({ list: [], more: undefined }) : statusItems(ctx, options?.untracked),
    ],
    { concurrency: 3 },
  )
  const rows = try files(
    ctx,
    ref,
    merge(
      list,
      extra.list.filter((item) => item.code === "??"),
    ),
    nums(stats),
    try batchPatches(ctx, ref, list, options),
    options,
  )
  return withMore(rows, extra.more)
}

const track = effect (ctx: Ctx, ref: string | undefined, options?: DiffOptions) => {
  if (!ref) {
    const status = try statusItems(ctx, options?.untracked)
    return withMore(try files(ctx, ref, status.list, new Map(), emptyBatch(), options), status.more)
  }
  return try diffAgainstRef(ctx, ref, options)
}

module platform {
// The platform code of git.vibe: host files, temporary paths and byte lengths, which a .vibe file does not read (EK4402).

import { randomUUID } from "crypto"
import fs from "fs/promises"
import os from "os"
import path from "path"

/**
 * The untracked files a throwaway index can batch: regular files no larger than `maxBytes`.
 * Directories (nested repositories) and symlinks diff differently through an index.
 */
export function batchableFiles(worktree: string, files: readonly string[], maxBytes: number): Promise<string[]> {
  return Promise.all(
    files.map(async (file) => {
      if (file.endsWith("/")) return
      const stat = await fs.lstat(path.join(worktree, file)).catch(() => undefined)
      if (!stat?.isFile()) return
      // A file this large could crowd every other file out of the batch's output budget.
      if (stat.size > maxBytes) return
      return file
    }),
  ).then((list) => list.filter((file) => file !== undefined))
}

/** Writes the NUL-separated pathspec list for a throwaway index and returns the path prefix of its files. */
export async function writeBatchList(files: readonly string[]): Promise<string> {
  const base = path.join(os.tmpdir(), `opencode-untracked-${randomUUID()}`)
  await fs.writeFile(`${base}.list`, files.map((file) => `${file}\0`).join(""))
  return base
}

/** Removes the pathspec list and throwaway index written under `base`. */
export function removeBatchFiles(base: string): Promise<void[]> {
  return Promise.all([`${base}.list`, `${base}.index`, `${base}.index.lock`].map((file) => fs.rm(file, { force: true })))
}

/** The sorted entry names of a directory. */
export function sortedEntries(directory: string): Promise<string[]> {
  return fs.readdir(directory).then((items) => items.toSorted())
}

/** The path of `to` relative to `from`, with `/` separators. @throws {never} */
export function relativePosixPath(from: string, to: string): string {
  return path.relative(from, to).split(path.sep).join("/")
}

/** UTF-8 byte length of a string. @throws {never} */
export function byteLength(text: string): number {
  return Buffer.byteLength(text)
}
}
