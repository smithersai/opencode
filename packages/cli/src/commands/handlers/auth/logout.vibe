import { intro, outro, spinner } from "@clack/prompts"
import { Commands } from "../../commands.ts"
import { Runtime } from "../../../framework/runtime.ts"
import { handlePromptErrors, requireInteractive } from "../../../ui/prompt.ts"
import { createClient, loadIntegrations, request } from "./shared.ts"
import { chooseCredential, chooseIntegration } from "./account.vibe"

export default Runtime.handler(
  Commands.commands.auth.commands.logout,
  Effect.fn("cli.auth.logout")((input) =>
    logout({
      target: Option.getOrUndefined(input.target),
      credential: Option.getOrUndefined(input.credential),
    }) |> handlePromptErrors(%)
  ),
)

const logout = effect (input: { target?: string; credential?: string }) =>
  try withSpan(
    effect {
      if (!input.target) {
        try requireInteractive("Pass an integration ID or name when running without an interactive terminal")
      }
      if (!input.credential) {
        try requireInteractive("Pass a credential ID or label when running without an interactive terminal")
      }
      try Effect.orDie(Effect.try({ try: () => intro("Log out of an account"), catch: (e) => e }))
      const client = try createClient()
      const integrations = try loadIntegrations(client)
      const integration = try chooseIntegration(integrations, input.target)
      const credentialID = try chooseCredential(integration, "log out", input.credential)
      const progress = try Effect.orDie(Effect.try({ try: () => spinner(), catch: (e) => e }))
      try Effect.orDie(Effect.try({ try: () => progress.start("Removing credential..."), catch: (e) => e }))
      try (request((signal) => client.credential.remove({ credentialID }, { signal }))
        |> Effect.tap(%, effect () => progress.stop(`Removed account from ${integration.name}`))
        |> Effect.tapCause(%, effect () => progress.stop("Failed to remove credential", 1)))
      try Effect.orDie(Effect.try({ try: () => outro("Done"), catch: (e) => e }))
    },
    "cli.auth.logout.run",
  )
