module platform {
  export const timeoutSignal = (milliseconds: number) => AbortSignal.timeout(milliseconds)

  export const inputIsTTY = () => process.stdin.isTTY

  export const outputIsTTY = () => process.stdout.isTTY
}

import { inputIsTTY, outputIsTTY, timeoutSignal } from platform
import { intro, log, outro, select, spinner, text } from "@clack/prompts"
import { Effect, Option } from "effect"
import type { FormAnswer, IntegrationInfo, OpenCodeClient } from "@opencode/client"
import { Commands } from "../../commands.ts"
import { Runtime } from "../../../framework/runtime"
import { selectIntegration, type IntegrationChoice } from "../../../ui/integration-picker"
import { handlePromptErrors, openUrl, prompt, requireInteractive } from "../../../ui/prompt"
import { answerForm, secret } from "./form"
import {
  createClient,
  connectMethods,
  loadIntegrations,
  location,
  request,
  resolveIntegration,
  resolveMethod,
  type ConnectMethod,
} from "./shared"

const integrationPriority = new Map([
  ["opencode-go", 0],
  ["opencode", 1],
  ["openai", 2],
  ["github-copilot", 3],
  ["anthropic", 4],
  ["google", 5],
])

export default Runtime.handler(
  Commands.commands.auth.commands.login,
  Effect.fn("cli.auth.login")((input) =>
    login({
      target: Option.getOrUndefined(input.target),
      method: Option.getOrUndefined(input.method),
      answer: input.answer,
    }).pipe(handlePromptErrors)
  ),
)

const login = Effect.fn("cli.auth.login.run")(effect function(input: {
  target?: string
  method?: string
  answer?: ReadonlyArray<string>
}) {
  if (!input.target) {
    try requireInteractive("Pass an integration ID or name when running without an interactive terminal")
  }
  void (try ((args: Parameters<typeof intro>) => Effect.try(() => intro(...args)).pipe(Effect.orDie))([
    "Connect an integration",
  ]))
  const client = try createClient()
  const integration = try findIntegration(client, input.target)
  const methods = connectMethods(integration)
  if (methods.length === 0) try Effect.fail(new Error(`${integration.name} has no interactive login methods`))
  const method = try chooseMethod(methods, input.method)
  const answer = try answerForm(method.type === "command" ? undefined : method.form, input.answer)
  try authenticate(client, integration, method, answer)
  void (try ((args: Parameters<typeof outro>) => Effect.try(() => outro(...args)).pipe(Effect.orDie))(["Done"]))
})

const findIntegration = Effect.fn("cli.auth.login.integration")(
  effect function(client: OpenCodeClient, target?: string) {
    if (target && URL.canParse(target)) {
      const protocol = new URL(target).protocol
      if (protocol === "http:" || protocol === "https:") {
        const progress =
          try ((args: Parameters<typeof spinner>) => Effect.try(() => spinner(...args)).pipe(Effect.orDie))([])
        void (try ((args: Parameters<typeof progress.start>) =>
          Effect.try(() => progress.start(...args)).pipe(Effect.orDie))(["Discovering authentication provider..."]))
        try request((signal) => client.integration.wellknown.add({ url: target, location }, { signal })).pipe(
          Effect.tap(() => Effect.sync(() => progress.stop("Authentication provider discovered"))),
          Effect.tapCause(() => Effect.sync(() => progress.stop("Discovery failed", 1))),
        )
      }
    }
    const integrations = try loadIntegrations(client)
    if (target) return try resolveIntegration(integrations, target)
    const choices = loginChoices(integrations)
    if (choices.length === 0) return try Effect.fail(new Error("No authentication integrations are available"))
    const id = try prompt<string>(() => selectIntegration(choices))
    return try resolveIntegration(integrations, id)
  },
)

export function loginChoices(integrations: IntegrationInfo[]): IntegrationChoice[] {
  return integrations
    .filter((integration) => connectMethods(integration).length > 0)
    .toSorted(
      (a, b) =>
        Number(b.metadata?.source === "mcp") - Number(a.metadata?.source === "mcp")
        || (integrationPriority.get(a.id) ?? integrationPriority.size)
          - (integrationPriority.get(b.id) ?? integrationPriority.size)
        || a.name.localeCompare(b.name)
        || a.id.localeCompare(b.id),
    )
    .map((integration) => ({
      value: integration.id,
      label: integration.name,
      category: integration.metadata?.source === "mcp"
        ? "MCP"
        : integrationPriority.has(integration.id)
        ? "Popular"
        : "Services",
      connected: integration.connections.length > 0,
    }))
}

const chooseMethod = Effect.fn("cli.auth.login.method")(effect function(methods: ConnectMethod[], target?: string) {
  if (target) return try resolveMethod(methods, target)
  if (methods.length === 1) return methods[0]
  try requireInteractive("Pass --method when running without an interactive terminal")
  const id = try prompt<string>(() =>
    select({
      message: "Select login method",
      options: methods.map((method) => {
        if (method.type === "key") return { value: "key", label: method.label ?? "API key" }
        return { value: method.id, label: method.label }
      }),
    })
  )
  return try resolveMethod(methods, id)
})

const authenticate = Effect.fn("cli.auth.login.authenticate")(effect function(
  client: OpenCodeClient,
  integration: IntegrationInfo,
  method: ConnectMethod,
  answer?: FormAnswer,
) {
  if (method.type === "key") return try keyLogin(client, integration, method, answer)
  if (method.type === "command") return try commandLogin(client, integration, method)
  if (method.type === "external") return try externalLogin(client, integration, method, answer)
  return try oauthLogin(client, integration, method, answer)
})

const externalLogin = Effect.fn("cli.auth.login.external")(effect function(
  client: OpenCodeClient,
  integration: IntegrationInfo,
  method: Extract<ConnectMethod, { type: "external" }>,
  answer?: FormAnswer,
) {
  const progress = try ((args: Parameters<typeof spinner>) => Effect.try(() => spinner(...args)).pipe(Effect.orDie))(
    [],
  )
  void (try ((args: Parameters<typeof progress.start>) =>
    Effect.try(() => progress.start(...args)).pipe(Effect.orDie))(["Saving credential..."]))
  try request((signal) =>
    client.integration.connect.external(
      { integrationID: integration.id, methodID: method.id, answer, location },
      { signal },
    )
  ).pipe(
    Effect.tap(() => Effect.sync(() => progress.stop(`Connected to ${integration.name}`))),
    Effect.tapCause(() => Effect.sync(() => progress.stop("Authentication failed", 1))),
  )
})

const keyLogin = Effect.fn("cli.auth.login.key")(effect function(
  client: OpenCodeClient,
  integration: IntegrationInfo,
  method: Extract<ConnectMethod, { type: "key" }>,
  answer?: FormAnswer,
) {
  const key = try secret(method.label ?? `Enter your ${integration.name} API key`)
  const progress = try ((args: Parameters<typeof spinner>) => Effect.try(() => spinner(...args)).pipe(Effect.orDie))(
    [],
  )
  void (try ((args: Parameters<typeof progress.start>) =>
    Effect.try(() => progress.start(...args)).pipe(Effect.orDie))(["Saving credential..."]))
  try request((signal) =>
    client.integration.connect.key({ integrationID: integration.id, key, answer, location }, { signal })
  ).pipe(
    Effect.tap(() => Effect.sync(() => progress.stop(`Connected to ${integration.name}`))),
    Effect.tapCause(() => Effect.sync(() => progress.stop("Authentication failed", 1))),
  )
})

export const oauthLogin = Effect.fn("cli.auth.login.oauth")(effect function(
  client: OpenCodeClient,
  integration: IntegrationInfo,
  method: Extract<ConnectMethod, { type: "oauth" }>,
  answer?: FormAnswer,
  label?: string,
) {
  const progress = try ((args: Parameters<typeof spinner>) => Effect.try(() => spinner(...args)).pipe(Effect.orDie))(
    [],
  )
  void (try ((args: Parameters<typeof progress.start>) =>
    Effect.try(() => progress.start(...args)).pipe(Effect.orDie))(["Starting authorization..."]))
  const started = try request((signal) =>
    client.integration.oauth.connect(
      { integrationID: integration.id, methodID: method.id, answer, label, location },
      { signal },
    )
  ).pipe(Effect.tapCause(() => Effect.sync(() => progress.stop("Authentication failed", 1))))
  const attempt = started.data
  try Effect.addFinalizer(() =>
    request(() =>
      client.integration.oauth.cancel(
        { integrationID: integration.id, attemptID: attempt.attemptID, location },
        { signal: timeoutSignal(5_000) },
      )
    ).pipe(Effect.ignore)
  )
  void (try ((args: Parameters<typeof progress.stop>) => Effect.try(() => progress.stop(...args)).pipe(Effect.orDie))([
    "Authorization started",
  ]))
  void (try ((args: Parameters<typeof log.info>) => Effect.try(() => log.info(...args)).pipe(Effect.orDie))([
    attempt.instructions,
  ]))
  void (try ((args: Parameters<typeof log.info>) => Effect.try(() => log.info(...args)).pipe(Effect.orDie))([
    attempt.url,
  ]))
  if (
    (try ((args: Parameters<typeof inputIsTTY>) => Effect.try(() => inputIsTTY(...args)).pipe(Effect.orDie))([]))
    && (try ((args: Parameters<typeof outputIsTTY>) => Effect.try(() => outputIsTTY(...args)).pipe(Effect.orDie))([]))
  ) try openUrl(attempt.url)

  if (attempt.mode === "code") {
    try requireInteractive("This login requires an interactive terminal to enter the authorization code")
    const code = try prompt<string>(() =>
      text({ message: "Paste the authorization code", validate: (value) => (!value ? "Required" : undefined) })
    )
    const completing =
      try ((args: Parameters<typeof spinner>) => Effect.try(() => spinner(...args)).pipe(Effect.orDie))([])
    void (try ((args: Parameters<typeof completing.start>) =>
      Effect.try(() => completing.start(...args)).pipe(Effect.orDie))(["Completing authorization..."]))
    try request((signal) =>
      client.integration.oauth.complete(
        { integrationID: integration.id, attemptID: attempt.attemptID, code, location },
        { signal },
      )
    ).pipe(
      Effect.tap(() => Effect.sync(() => completing.stop(`Connected to ${integration.name}`))),
      Effect.tapCause(() => Effect.sync(() => completing.stop("Authentication failed", 1))),
    )
    return
  }

  // Clack's spinner captures Ctrl+C and exits the process directly, which would skip the finalizer that
  // cancels the attempt. Waits that can last minutes use plain log lines so Ctrl+C interrupts normally.
  void (try ((args: Parameters<typeof log.step>) => Effect.try(() => log.step(...args)).pipe(Effect.orDie))([
    "Waiting for authorization...",
  ]))
  const status = try waitForOAuth(client, integration.id, attempt.attemptID)
  if (status.status === "complete") {
    void (try ((args: Parameters<typeof log.success>) => Effect.try(() => log.success(...args)).pipe(Effect.orDie))([
      `Connected to ${integration.name}`,
    ]))
    return
  }
  if (status.status === "failed") try Effect.fail(new Error(status.message))
  try Effect.fail(new Error("Authorization expired"))
})

const commandLogin = Effect.fn("cli.auth.login.command")(effect function(
  client: OpenCodeClient,
  integration: IntegrationInfo,
  method: Extract<ConnectMethod, { type: "command" }>,
) {
  const progress = try ((args: Parameters<typeof spinner>) => Effect.try(() => spinner(...args)).pipe(Effect.orDie))(
    [],
  )
  void (try ((args: Parameters<typeof progress.start>) =>
    Effect.try(() => progress.start(...args)).pipe(Effect.orDie))(["Starting authentication command..."]))
  const started = try request((signal) =>
    client.integration.command.connect({ integrationID: integration.id, methodID: method.id, location }, { signal })
  ).pipe(Effect.tapCause(() => Effect.sync(() => progress.stop("Authentication failed", 1))))
  try Effect.addFinalizer(() =>
    request(() =>
      client.integration.command.cancel(
        {
          integrationID: integration.id,
          attemptID: started.data.attemptID,
          location,
        },
        { signal: timeoutSignal(5_000) },
      )
    ).pipe(Effect.ignore)
  )
  void (try ((args: Parameters<typeof progress.stop>) => Effect.try(() => progress.stop(...args)).pipe(Effect.orDie))([
    "Authentication command started",
  ]))
  // The status message accumulates the command's stderr; print each completed line once.
  let printed = 0
  void (try ((args: Parameters<typeof log.step>) => Effect.try(() => log.step(...args)).pipe(Effect.orDie))([
    "Waiting for authentication command...",
  ]))
  const status = try waitForCommand(client, integration.id, started.data.attemptID, (message) => {
    const end = message.lastIndexOf("\n") + 1
    if (end <= printed) return
    const output = message.slice(printed, end).trim()
    printed = end
    if (output) log.message(output)
  })
  if (status.status === "complete") {
    void (try ((args: Parameters<typeof log.success>) => Effect.try(() => log.success(...args)).pipe(Effect.orDie))([
      `Connected to ${integration.name}`,
    ]))
    return
  }
  if (status.status === "failed") try Effect.fail(new Error(status.message))
  try Effect.fail(new Error("Authentication expired"))
})

const waitForOAuth = Effect.fn("cli.auth.login.oauth.wait")(effect function(
  client: OpenCodeClient,
  integrationID: string,
  attemptID: string,
) {
  while (true) {
    const response = try request((signal) =>
      client.integration.oauth.status({ integrationID, attemptID, location }, { signal })
    )
    if (response.data.status !== "pending") return response.data
    try Effect.sleep(500)
  }
})

const waitForCommand = Effect.fn("cli.auth.login.command.wait")(effect function(
  client: OpenCodeClient,
  integrationID: string,
  attemptID: string,
  update: (message: string) => void,
) {
  while (true) {
    const response = try request((signal) =>
      client.integration.command.status({ integrationID, attemptID, location }, { signal })
    )
    if (response.data.status !== "pending") return response.data
    if (response.data.message) update(response.data.message)
    try Effect.sleep(500)
  }
})
