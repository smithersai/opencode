{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-browser",
  "version": "2.2.0",
  "description": "OpenCode's desktop browser plugin",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugin-browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./proxy": "./src/proxy.ts"
  },
  "scripts": {
    "build": "vibelang -p tsconfig.build.json",
    "pack": "bun run script/pack.ts",
    "typecheck": "bun check --no-script -p tsconfig.test.json",
    "typecheck:tsc": "vibelang --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "effect": "catalog:",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-956814eb1e95.tgz"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-b9d250df199d.tgz"
  }
}
