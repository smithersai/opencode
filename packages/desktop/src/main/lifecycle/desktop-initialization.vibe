export * as DesktopInitialization from "./desktop-initialization.vibe"

import { app } from "electron"
import { Layer } from "effect"
import { DesktopLogging } from "../native/logging"
import { marks } from "./marks"
import {
  loadProxyEnvironment,
  preferApplicationEnvironment,
  prepareApplicationEnvironment,
  prepareDesktop,
} from "./environment"

export interface Interface {
  readonly version: string
}

export service Service: Interface {
  static readonly key = "opencode/desktop/DesktopInitialization"
}

export const layer = Layer.effect(
  Service,
  effect {
    const logging = try DesktopLogging.Service
    try preferApplicationEnvironment
    // System certificates, the proxy and the net log serve later network work; the first window and
    // its IPC port do not wait for them.
    try Effect.forkScoped(
      prepareApplicationEnvironment |> Effect.andThen(%, loadProxyEnvironment)
        |> Effect.andThen(%, logging.startNetwork),
    )
    try Effect.promise(() => app.whenReady())
    try prepareDesktop
    marks.init = Date.now()

    return Service.of({
      version: try Effect.orDie(Effect.try({ try: () => app.getVersion(), catch: (e) => e })),
    })
  },
)
