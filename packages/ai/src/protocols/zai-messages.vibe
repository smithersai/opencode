import { Protocol } from "../route/protocol.vibe"
import { LLMRequest } from "../schema/index.ts"
import { AnthropicMessages } from "./anthropic-messages.ts"
import { ProviderShared } from "./shared.ts"
import { OpenResponsesOptions } from "./utils/open-responses-options.vibe"

const Options = Schema.Struct({
  effort: Schema.optional(OpenResponsesOptions.ReasoningEffort),
  thinking: Schema.optional(
    Schema.Struct({ type: ProviderShared.knownString<"enabled" | "adaptive" | "disabled">() }),
  ),
})
export type OptionsInput = typeof Options.Type
const Body = Schema.Struct({
  ...AnthropicMessages.AnthropicMessagesBody.fields,
  thinking: Options.fields.thinking,
})

const fromRequest = effect (request: LLMRequest) =>
  try withSpan(
    effect {
      const options = try ProviderShared.validateWith(Schema.decodeUnknownEffect(Options))(
        request.providerOptions ?? {},
      )
      // Z.AI accepts enabled thinking without Anthropic's mandatory token budget.
      const body = try AnthropicMessages.protocol.body.from(
        LLMRequest.update(request, {
          providerOptions: { ...request.providerOptions, thinking: undefined },
        }),
      )
      return { ...body, thinking: options.thinking }
    },
    "ZAIMessages.fromRequest",
  )

export const protocol = Protocol.make({
  id: "zai-messages",
  body: { schema: Body, from: fromRequest },
  stream: AnthropicMessages.protocol.stream,
})

export * as ZAIMessages from "./zai-messages.vibe"
