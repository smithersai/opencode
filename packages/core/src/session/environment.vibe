export * as SessionEnvironment from "./environment.vibe"

import { makeGlobalNode } from "@opencode/util/effect/app-node"
import { SessionSchema } from "./schema.ts"

export type Variables = Readonly<Record<string, string>>

export interface Interface {
  readonly get: (sessionID: SessionSchema.ID) => Variables | undefined!!
  readonly set: (sessionID: SessionSchema.ID, variables: Variables) => void!!
  readonly clear: (sessionID: SessionSchema.ID) => void!!
}

export class Service extends Context.Service<Service, Interface>()("@opencode/SessionEnvironment") {}

const layer = Layer.sync(Service, () => {
  const environments = new Map<SessionSchema.ID, Variables>()

  return Service.of({
    get: effect (sessionID) => environments.get(sessionID),
    set: effect (sessionID, variables) => {
      environments.set(sessionID, { ...variables })
    },
    clear: effect (sessionID) => {
      environments.delete(sessionID)
    },
  })
})

export const node = makeGlobalNode({ service: Service, layer, deps: [] })
