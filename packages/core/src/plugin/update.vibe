export * as PluginUpdate from "./update.js"

import { Npm } from "@opencode/util/npm"
import { EffectFlock } from "@opencode/util/effect-flock"
import { makeGlobalNode } from "@opencode/util/effect/app-node"
import { KeyedMutex } from "../effect/keyed-mutex.js"
import { withKeyedLock } from "../effect/keyed-mutex.native.ts"

const interval = 24 * 60 * 60 * 1_000

interface Change {
  readonly target: string
  readonly outdated: boolean
  readonly updating: boolean
}

export interface Interface {
  readonly check: (target: string, options?: { readonly refresh?: boolean }) => boolean!!
  readonly update: (target: string) => void!(Npm.InstallFailedError | EffectFlock.LockError)
  readonly changes: () => Stream.Stream<Change>
}

export service Service: Interface { static readonly key = "@opencode/PluginUpdate";}

const layer = Layer.effect(
  Service,
  effect {
    const npm = try Npm.Service
    const locks = try Effect.orDie(Effect.try({ try: () => KeyedMutex.makeUnsafe<string>(), catch: (error) => error }))
    const status = new Map<string, { readonly outdated: boolean; readonly checkedAt: number }>()
    const changes = try PubSub.unbounded<Change>()

    return Service.of({
      check: (target, options) =>
        withKeyedLock(locks, target,
          effect {
            const checkedAt = try Clock.currentTimeMillis
            const current = status.get(target)
            if (!options?.refresh && current && checkedAt - current.checkedAt < interval) return current.outdated
            const outdated = try (npm.check(target)
              |> Effect.tapCause(%, (cause) => Effect.logWarning("failed to check plugin update", { target, cause }))
              |> Effect.option(%))
            const value = Option.getOrElse(outdated, () => current?.outdated ?? false)
            status.set(target, { outdated: value, checkedAt })
            if ((current?.outdated ?? false) !== value) {
              try PubSub.publish(changes, { target, outdated: value, updating: false })
            }
            return value
          },
        ),
      // Serialize per target so a concurrent update cannot clear the in-progress flag of another still running.
      update: (target) =>
        withKeyedLock(locks, target,
          effect {
            const outdated = status.get(target)?.outdated ?? false
            try PubSub.publish(changes, { target, outdated, updating: true })
            try (npm.update(target)
              |> Effect.tap(%, effect () => status.delete(target))
              |> Effect.onExit(%, (exit) =>
                PubSub.publish(changes, {
                  target,
                  outdated: Exit.isSuccess(exit) ? false : outdated,
                  updating: false,
                })))
          },
        ),
      changes: () => Stream.fromPubSub(changes),
    })
  },
)

export const node = makeGlobalNode({ service: Service, layer, deps: [Npm.node] })
