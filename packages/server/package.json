{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/server",
  "version": "2.2.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script -b",
    "typecheck:tsc": "vibelang -b",
    "probe:workerd": "bun run script/workerd-probe.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@opencode/core": "workspace:*",
    "@opencode/protocol": "workspace:*",
    "@opencode/schema": "workspace:*",
    "@opencode/simulation": "workspace:*",
    "@opencode/util": "workspace:*",
    "effect": "catalog:",
    "vibelang-runtime": "file:../../.vibelang-toolchain/vibelang-runtime-0.0.11-60bd29302ace.tgz"
  },
  "devDependencies": {
    "@opencode-ai/pty": "0.3.1",
    "@opencode/client": "workspace:*",
    "@opencode/plugin": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "fast-check": "catalog:",
    "vibelang": "file:../../.vibelang-toolchain/vibelang-0.0.11-668770ff8f46.tgz",
    "vibelang-unplugin": "file:../../.vibelang-toolchain/vibelang-unplugin-0.0.11-7e3b05c3f55f.tgz"
  }
}
