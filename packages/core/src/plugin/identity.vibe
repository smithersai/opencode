export * as IdentityPlugin from "./identity.vibe"

import { SystemPart } from "@opencode/ai/effect"
import { define } from "@opencode/plugin/effect/plugin"
import type { SessionHooks } from "@opencode/plugin/effect/session"
import { Model } from "@opencode/schema/model"
import { OptimizePlugin } from "./optimize.vibe"

export function identity(model: { readonly name: string; readonly ref: Model.Ref }) {
  return [
    "# Your Model",
    `- Name: ${model.name}`,
    `- Provider ID: ${model.ref.providerID}`,
    `- Model ID: ${model.ref.id}`,
  ].join("\n")
}

export const Plugin = define({
  id: "opencode.prompt.identity",
  effect: effect (ctx): void!never!import("effect/Scope").Scope =>
    try withSpan(
      (effect (): void!never!import("effect/Scope").Scope => {
        const hook = (event: SessionHooks["context"]) =>
          do {
            const catchProgram = effect {
              const model = try OptimizePlugin.resolveModel(ctx, event)
              event.system.splice(1, 0, SystemPart.make(identity({ name: model.name, ref: event.model })))
            }
            effect {
              return catchProgram catch effect () => (undefined as void)
            }
          }
        try ctx.session.hook("context", hook)
        try ctx.session.hook("compaction", hook)
        try ctx.session.hook("generate", hook)
      })(),
      "IdentityPlugin",
    ),
})
