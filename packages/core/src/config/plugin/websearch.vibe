export * as ConfigWebSearchPlugin from "./websearch.vibe"

import { define } from "@opencode/plugin/effect/plugin"
import { Config } from "../../config.js"
import { ConfigEntryObserver } from "./entry-observer.js"

export const Plugin = define({
  id: "opencode.config.websearch",
  effect: effect (ctx) => {
    const config = try Config.Service
    const loaded = try ConfigEntryObserver.observe(config, ctx.event, ctx.websearch.reload())
    try ctx.websearch.transform((websearch) => {
      const selection = Config.latest(loaded.entries, "websearch")
      if (selection === false) websearch.default.set(false)
      if (selection) websearch.default.set(selection.provider)
    })
  },
})
