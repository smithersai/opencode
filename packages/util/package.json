{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/util",
  "version": "2.2.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/util"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    ".vibelang/js"
  ],
  "exports": {
    "./effect/layer-node": {
      "types": "./src/effect/layer-node.ts",
      "vibelang-source": "./src/effect/layer-node.ts",
      "default": "./.vibelang/js/src/effect/layer-node.js"
    },
    "./bom": {
      "types": "./src/bom.d.vibe.ts",
      "vibelang-source": "./src/bom.vibe",
      "default": "./.vibelang/js/src/bom.js"
    },
    "./patch": {
      "types": "./src/patch.d.vibe.ts",
      "vibelang-source": "./src/patch.vibe",
      "default": "./.vibelang/js/src/patch.js"
    },
    "./effect/app-node-platform": {
      "types": "./src/effect/app-node-platform.d.vibe.ts",
      "vibelang-source": "./src/effect/app-node-platform.vibe",
      "default": "./.vibelang/js/src/effect/app-node-platform.js"
    },
    "./heap-snapshot": {
      "types": "./src/heap-snapshot.d.vibe.ts",
      "vibelang-source": "./src/heap-snapshot.vibe",
      "default": "./.vibelang/js/src/heap-snapshot.js"
    },
    "./npm-config": {
      "types": "./src/npm-config.d.vibe.ts",
      "vibelang-source": "./src/npm-config.vibe",
      "default": "./.vibelang/js/src/npm-config.js"
    },
    "./effect-flock": {
      "types": "./src/effect-flock.d.vibe.ts",
      "vibelang-source": "./src/effect-flock.vibe",
      "default": "./.vibelang/js/src/effect-flock.js"
    },
    "./npm": {
      "types": "./src/npm.d.vibe.ts",
      "vibelang-source": "./src/npm.vibe",
      "default": "./.vibelang/js/src/npm.js"
    },
    "./process": {
      "types": "./src/process.d.vibe.ts",
      "vibelang-source": "./src/process.vibe",
      "default": "./.vibelang/js/src/process.js"
    },
    "./global": {
      "types": "./src/global.d.vibe.ts",
      "vibelang-source": "./src/global.vibe",
      "default": "./.vibelang/js/src/global.js"
    },
    "./observability/otlp": {
      "types": "./src/observability/otlp.d.vibe.ts",
      "vibelang-source": "./src/observability/otlp.vibe",
      "default": "./.vibelang/js/src/observability/otlp.js"
    },
    "./global.platform": null,
    "./observability/otlp.platform": null,
    "./*": {
      "types": "./src/*.ts",
      "vibelang-source": "./src/*.ts",
      "default": "./.vibelang/js/src/*.js"
    },
    "./bom.vibe.$call$ts": null,
    "./patch.vibe.$throw$ts": null,
    "./npm-config.host.platform": null,
    "./heap-snapshot.host.platform": null,
    "./heap-snapshot.platform": null,
    "./npm-config.platform": null,
    "./bom.vibe.-24-call-24-ts": null,
    "./patch.vibe.-24-throw-24-ts": null,
    "./effect-flock.platform": null,
    "./npm.platform": null,
    "./process.platform": null
  },
  "imports": {
    "#global-roots": {
      "workerd": {
        "types": "./src/global-roots.workerd.ts",
        "vibelang-source": "./src/global-roots.workerd.ts",
        "default": "./.vibelang/js/src/global-roots.workerd.js"
      },
      "default": {
        "types": "./src/global-roots.ts",
        "vibelang-source": "./src/global-roots.ts",
        "default": "./.vibelang/js/src/global-roots.js"
      }
    },
    "#runtime-import": {
      "workerd": {
        "types": "./src/runtime/import.workerd.ts",
        "vibelang-source": "./src/runtime/import.workerd.ts",
        "default": "./.vibelang/js/src/runtime/import.workerd.js"
      },
      "bun": {
        "types": "./src/runtime/import.bun.ts",
        "vibelang-source": "./src/runtime/import.bun.ts",
        "default": "./.vibelang/js/src/runtime/import.bun.js"
      },
      "node": {
        "types": "./src/runtime/import.node.ts",
        "vibelang-source": "./src/runtime/import.node.ts",
        "default": "./.vibelang/js/src/runtime/import.node.js"
      },
      "default": {
        "types": "./src/runtime/import.bun.ts",
        "vibelang-source": "./src/runtime/import.bun.ts",
        "default": "./.vibelang/js/src/runtime/import.bun.js"
      }
    },
    "#vibelang/emitted/src/effect/app-node-platform": {
      "types": "./src/effect/app-node-platform.d.vibe.ts",
      "vibelang-source": "./src/effect/app-node-platform.vibe",
      "default": "./.vibelang/js/src/effect/app-node-platform.js"
    }
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "test": "bun test --only-failures",
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "vibelang --noEmit",
    "typecheck:dist": "bun run build && bun typecheck --project tsconfig.dist.json"
  },
  "dependencies": {
    "@effect/opentelemetry": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@npmcli/arborist": "catalog:",
    "@npmcli/config": "10.8.1",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.219.0",
    "@opentelemetry/context-async-hooks": "2.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/resources": "2.8.0",
    "@opentelemetry/sdk-logs": "0.219.0",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/sdk-trace-node": "2.8.0",
    "cross-spawn": "catalog:",
    "effect": "catalog:",
    "glob": "13.0.5",
    "mime-types": "3.0.2",
    "minimatch": "10.2.5",
    "npm-package-arg": "13.0.2",
    "open": "11.0.4",
    "pacote": "21.5.1",
    "vibelang-runtime": "file:../../.vibelang-toolchain/0.0.14-pre.b9285da0f2be/tarballs/vibelang-runtime-0.0.14-pre.b9285da0f2be.tgz"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@types/cross-spawn": "catalog:",
    "@types/node": "catalog:",
    "@types/npm-package-arg": "6.1.4",
    "@types/npmcli__arborist": "6.3.3",
    "@types/pacote": "11.1.8",
    "@typescript/native": "catalog:",
    "jsqr": "1.4.0",
    "vibelang": "file:../../.vibelang-toolchain/0.0.14-pre.b9285da0f2be/tarballs/vibelang-0.0.14-pre.b9285da0f2be.tgz",
    "vibelang-vite": "file:../../.vibelang-toolchain/0.0.14-pre.b9285da0f2be/tarballs/vibelang-vite-0.0.14-pre.b9285da0f2be.tgz"
  }
}
