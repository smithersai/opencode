import { Protocol } from "../route/protocol.vibe"
import { LLMRequest } from "../schema/index.ts"
import { AnthropicMessages } from "./anthropic-messages.ts"
import { ProviderShared } from "./shared.ts"
import { OpenResponsesOptions } from "./utils/open-responses-options.vibe"

const Options = Schema.Struct({
  effort: Schema.optional(OpenResponsesOptions.ReasoningEffort),
  thinking: Schema.optional(
    Schema.Struct({
      type: ProviderShared.knownString<"enabled" | "disabled">(),
      budgetTokens: Schema.optional(Schema.Int),
      budget_tokens: Schema.optional(Schema.Int),
    }),
  ),
})
export type OptionsInput = typeof Options.Type & Pick<AnthropicMessages.OptionsInput, "outputConfig">
export const protocol = Protocol.make({
  id: "alibaba-messages",
  body: {
    schema: Schema.Struct({
      ...AnthropicMessages.AnthropicMessagesBody.fields,
      thinking: Schema.optional(Schema.Struct({ type: Schema.String, budget_tokens: Schema.optional(Schema.Int) })),
    }),
    from: effect (req) =>
      try withSpan(
        effect {
          const opts = try (try Effect.orDie(Effect.try({ try: () => ProviderShared.validateWith(Schema.decodeUnknownEffect(Options)), catch: (e) => e })))(req.providerOptions ?? {})
          // Model Studio accepts enabled thinking without Anthropic's mandatory token budget.
          const body = try AnthropicMessages.protocol.body.from(
            LLMRequest.update(req, {
              providerOptions: { ...req.providerOptions, thinking: undefined },
            }),
          )
          const budget = opts.thinking?.budgetTokens ?? opts.thinking?.budget_tokens
          return {
            ...body,
            thinking: opts.thinking === undefined
              ? undefined
              : {
                type: opts.thinking.type,
                budget_tokens: budget === undefined
                  ? undefined
                  : try Effect.orDie(Effect.try({ try: () => ProviderShared.fitThinkingBudget(budget, body.max_tokens), catch: (e) => e })),
              },
          }
        },
        "AlibabaMessages.fromRequest",
      ),
  },
  stream: AnthropicMessages.protocol.stream,
})

export * as AlibabaMessages from "./alibaba-messages.vibe"
