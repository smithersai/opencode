import { Protocol } from "../route/protocol.vibe"
import { CacheTTL, type LLMRequest } from "../schema/index.ts"
import { AnthropicMessages } from "./anthropic-messages.ts"
import { MetaResponses } from "./meta-responses.ts"
import { JsonObject, optionalArray, ProviderShared } from "./shared.ts"

const WebSearch = Schema.Struct({
  type: Schema.Literal("web_search"),
  name: Schema.Literal("web_search"),
  user_location: MetaResponses.WebSearch.fields.user_location,
})
const MetaCacheControl = Schema.Struct({
  type: Schema.tag("ephemeral"),
  ttl: Schema.optional(CacheTTL),
})
schema FunctionTool {
  name: string
  description: string
  input_schema: JsonObject
  cache_control?: MetaCacheControl
}
const Body = Schema.Struct({
  ...AnthropicMessages.AnthropicMessagesBody.fields,
  tools: optionalArray(Schema.Union([FunctionTool, WebSearch])),
})

const fromRequest = effect (request: LLMRequest) =>
  try withSpan(
    effect {
      const projected = ProviderShared.flattenToolRequest(request)
      const body = try AnthropicMessages.protocol.body.from(projected.request)
      return {
        ...body,
        messages: body.messages.map((message) => {
          if (message.role !== "user") return message
          const videos: Array<(typeof message.content)[number]> = []
          const content = message.content.map((block) => {
            if (block.type !== "tool_result" || typeof block.content === "string") return block
            videos.push(...block.content.filter((item) => item.type === "video"))
            return { ...block, content: block.content.filter((item) => item.type !== "video") }
          })
          return videos.length === 0 ? message : { ...message, content: [...content, ...videos] }
        }),
        tools: body.tools === undefined
          ? undefined
          : try Effect.forEach(body.tools, effect (tool, index) => {
            const native = projected.tools[index]?.native
            if (native === undefined) return tool
            const search = try ProviderShared.validateWith(Schema.decodeUnknownEffect(MetaResponses.WebSearch))(
              native.meta,
            )
            if (search.search_context_size !== undefined) {
              throw ProviderShared.invalidRequest("Meta Messages does not support searchContextSize")
            }
            return { type: "web_search" as const, name: "web_search" as const, user_location: search.user_location }
          }),
      }
    },
    "MetaMessages.fromRequest",
  )

export const protocol = Protocol.make({
  id: "meta-messages",
  body: { schema: Body, from: fromRequest },
  stream: AnthropicMessages.protocol.stream,
})

export * as MetaMessages from "./meta-messages.vibe"
